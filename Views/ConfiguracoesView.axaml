<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             x:Class="GetStartedApp.Views.ConfiguracoesView"
             x:DataType="vm:ConfiguracoesViewModel">
    
    <Border Background="#ECF0F1" Padding="40">
        <Grid RowDefinitions="Auto, *">
            
            <TextBlock Grid.Row="0" Text="Configurações e Equipe" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <TabControl Grid.Row="1">
                <TabItem Header="👨‍💼 Vendedores / Usuários" FontSize="18">
                    <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                        
                        <!-- Lista de Vendedores -->
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Usuários Ativos" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="#34495E"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding VendedoresLista}" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F9F9" CornerRadius="5" Padding="15,10" Margin="0,5">
                                                <TextBlock Text="{Binding Nome}" FontSize="18" Foreground="#2C3E50" FontWeight="Medium"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Novo Vendedor -->
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                            <StackPanel Spacing="15">
                                <TextBlock Text="Cadastrar Novo" FontSize="20" FontWeight="SemiBold" Foreground="#34495E"/>
                                
                                <TextBlock Text="Nome Completo / Cargo:" Foreground="#7F8C8D" />
                                <TextBox Text="{Binding NovoVendedorNome}" FontSize="16" Padding="10" PlaceholderText="Ex: Roberto (Supervisor)"/>

                                <Button Command="{Binding AdicionarVendedorCommand}" Content="➕ Adicionar Operador" Background="#27AE60" Foreground="White" FontSize="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" Margin="0,10,0,0"/>

                                <TextBlock Text="{Binding MensagemAviso}" Foreground="#2980B9" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </TabItem>
                
                <!-- Placeholder de aba futura de Config do PDV -->
                <TabItem Header="📠 Impressora / Cupom" FontSize="18">
                    <Border Padding="20">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Opções em Desenvolvimento" FontSize="24" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                            <TextBlock Text="Aqui você poderá configurar rodapé de cupom NFC-e, Porta COM da Impressora Térmica, e Margens." FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>