<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             x:Class="GetStartedApp.Views.ConfiguracoesView"
             x:DataType="vm:ConfiguracoesViewModel">
    
    <Border Background="#F4F6F7" Padding="20">
        <Grid RowDefinitions="Auto, *">
            
            <TextBlock Grid.Row="0" Text="⚙️ Gestão de Equipe e Configurações" FontSize="32" FontWeight="Black" Foreground="#2C3E50" Margin="0,0,0,25"/>

            <TabControl Grid.Row="1" Background="Transparent">
                
                <!-- ABA 1: RH e EQUIPE -->
                <TabItem Header="👥 Operadores de Caixa (RH)" FontSize="18" FontWeight="SemiBold">
                    <Grid ColumnDefinitions="*, *" Margin="0,20,0,0">
                        
                        <!-- Lista de Vendedores -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,15,0" BoxShadow="0 4 15 0 #1A000000">
                            <Grid RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="Membros Ativos" FontSize="22" FontWeight="Bold" Foreground="#34495E"/>
                                    <TextBlock Text="Lista de funcionários autorizados a operar caixas." FontSize="14" Foreground="#95A5A6" Margin="0,5,0,0"/>
                                </StackPanel>
                                
                                <ListBox Grid.Row="1" ItemsSource="{Binding VendedoresLista}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#Fdfdfd" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,5">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#3498DB" Margin="0,0,15,0">
                                                        <TextBlock Text="👤" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="18" Foreground="#2C3E50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Novo Vendedor -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" Margin="15,0,0,0" BoxShadow="0 4 15 0 #1A000000" VerticalAlignment="Top">
                            <StackPanel Spacing="20">
                                <TextBlock Text="➕ Cadastrar Operador" FontSize="22" FontWeight="Bold" Foreground="#34495E"/>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Nome Completo / Matrícula:" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D" />
                                    <TextBox Text="{Binding NovoVendedorNome}" FontSize="16" Padding="12" Background="#F4F6F7" BorderThickness="0" CornerRadius="6" PlaceholderText="Ex: Amanda Silva (Turno Manhã)"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Nível de Permissão (Visual):" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D" />
                                    <!-- Um ComboBox apenas visual/Mock para dar cara de sistema completo -->
                                    <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" Background="#F4F6F7" BorderThickness="0" Padding="12">
                                        <ComboBoxItem Content="Operador Padrão (PDV Apenas)"/>
                                        <ComboBoxItem Content="Supervisor (Contagem de Estoque)"/>
                                        <ComboBoxItem Content="Gerente Master (Acesso Total)"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Command="{Binding AdicionarVendedorCommand}" Content="✅ Registrar Funcionário" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15" CornerRadius="8" Cursor="Hand" Margin="0,15,0,0"/>

                                <TextBlock Text="{Binding MensagemAviso}" Foreground="#E74C3C" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </TabItem>
                
                <!-- ABA 2: HARDWARE E IMPRESSÃO (Placeholder bonito) -->
                <TabItem Header="🖨️ Hardware e Impressão" FontSize="18" FontWeight="SemiBold">
                    <Border Background="White" CornerRadius="12" Padding="40" Margin="0,20,0,0" BoxShadow="0 4 15 0 #1A000000">
                        <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🛠️ Módulo de Integração Desativado" FontSize="24" FontWeight="Black" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            <TextBlock Text="As configurações de Spooler do Windows/Linux e portas escaneadas para Balanças Filizola / Toledo e Impressoras Elgin / Epson aparecerão aqui na próxima versão base." 
                                       FontSize="16" Foreground="#95A5A6" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center"/>
                            
                            <!-- Botoes Ficticios -->
                            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,30,0,0">
                                <Button Content="Testar Comunicação SAT" Background="#E67E22" Foreground="White" Padding="20,10" CornerRadius="6" IsEnabled="False"/>
                                <Button Content="Localizar Balanças (COM)" Background="#95A5A6" Foreground="White" Padding="20,10" CornerRadius="6" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>