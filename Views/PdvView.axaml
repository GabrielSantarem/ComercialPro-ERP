<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             xmlns:models="using:GetStartedApp.Models"
             x:Class="GetStartedApp.Views.PdvView"
             x:DataType="vm:PdvViewModel"
             x:Name="RootWindow" Focusable="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F12" Command="{Binding AbrirModalPagamentoCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding LimparCarrinhoCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding LimparCarrinhoCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding RemoverItemSelecionadoCommand}" />
    </UserControl.KeyBindings>

    <Grid Background="#1E272E">
        <!-- CAMADA 1: CONTEÚDO PRINCIPAL (PDV FÍSICO) -->
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- TOPO: Informações do Caixa -->
            <Border Grid.Row="0" Background="#2C3E50" Padding="15,10" BorderBrush="#000" BorderThickness="0,0,0,3">
                <Grid ColumnDefinitions="*, *, *">
                    <TextBlock Grid.Column="0" Text="🛒 Caixa Livre - Comercial Pro" Foreground="#F1C40F" FontSize="20" FontWeight="Black"/>
                    <TextBlock Grid.Column="1" Text="Terminal: 01" Foreground="White" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding VendedorSelecionado.Nome, StringFormat='{}Operador: {0}'}" Foreground="#95A5A6" FontSize="18" FontWeight="Medium" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- MEIO: Divisão Frente de Caixa -->
            <Grid Grid.Row="1" ColumnDefinitions="6*, 4*">
                
                <!-- Lado Esquerdo: Cupom (Lista de Itens) -->
                <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="4" BorderBrush="#BDC3C7" BorderThickness="2" ClipToBounds="True">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <Border Grid.Row="0" Background="#F4F6F7" Padding="10,12" BorderBrush="#BDC3C7" BorderThickness="0,0,0,2">
                            <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*">
                                <TextBlock Grid.Column="0" Text="DESCRIÇÃO" FontWeight="Black" Foreground="#2C3E50" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="QTD" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="V. UNIT (R$)" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="TOTAL (R$)" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding Carrinho}" SelectedItem="{Binding ItemSelecionado}" Background="White" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProdutoItem">
                                    <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" Padding="5,8">
                                        <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*">
                                            <TextBlock Grid.Column="0" Text="{Binding Produto.Nome}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="16" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Produto.Preco, StringFormat='{}{0:N2}'}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat='{}{0:N2}'}" FontSize="18" FontWeight="Black" Foreground="#2C3E50" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#FFF3E0" Padding="15" BorderBrush="#F39C12" BorderThickness="0,2,0,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Qtd de Itens Registrados:" FontSize="16" Foreground="#D35400" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Carrinho.Count}" FontSize="24" Foreground="#D35400" FontWeight="Black" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lado Direito: Scanner, Produto, Subtotal -->
                <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto, Auto" Margin="0,15,15,15">
                    
                    <!-- 1. Campo de Código de Barras (Foco) -->
                    <Border Grid.Row="0" Background="#fdfdfd" CornerRadius="6" Padding="15" BorderBrush="#E67E22" BorderThickness="3">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CÓDIGO DE BARRAS / BUSCA (F2):" FontSize="14" FontWeight="Black" Foreground="#34495E" />
                            <TextBox x:Name="TxtPesquisa" Text="{Binding TextoPesquisa}" FontSize="24" FontWeight="Bold" Padding="10" Background="#EAEDED" BorderThickness="0" CornerRadius="4">
                                
                            </TextBox>
                            
                            <!-- Lista rápida flutuante pra guiar a busca visual (some se vazio) -->
                            <ListBox ItemsSource="{Binding ResultadosPesquisa}" Focusable="False" MaxHeight="120" Background="White" IsVisible="{Binding ResultadosPesquisa.Count}" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Produto">
                                        <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="Medium" Foreground="#2980B9"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,15,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SUPERMERCADO PRO" FontSize="40" FontWeight="Black" Foreground="#2C3740" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="SISTEMA NCF-e ATIVO" FontSize="18" FontWeight="Bold" Foreground="#2C3740" HorizontalAlignment="Center" Opacity="0.4"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL -->
                    <Border Grid.Row="3" Background="#27AE60" CornerRadius="8" Padding="25" BoxShadow="0 10 20 0 #33000000">
                        <StackPanel Spacing="5">
                            <TextBlock Text="TOTAL DA VENDA" FontSize="20" FontWeight="Black" Foreground="#ABEBC6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalVenda, StringFormat='{}R$ {0:N2}'}" FontSize="65" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                </Grid>
            </Grid>
            
            <!-- RODAPÉ: Atalhos Físicos -->
            <Border Grid.Row="2" Background="#2C3E50" Padding="15,10">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#34495E" CornerRadius="4" Padding="10,5" Margin="5">
                        <TextBlock Text="[F2] Focar Busca" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <Border Background="#34495E" CornerRadius="4" Padding="10,5" Margin="5">
                        <TextBlock Text="[ENTER] Lançar" Foreground="#F1C40F" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <Border Background="#34495E" CornerRadius="4" Padding="10,5" Margin="5">
                        <TextBlock Text="[F8] Cancela Item" Foreground="#E74C3C" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <Border Background="#34495E" CornerRadius="4" Padding="10,5" Margin="5">
                        <TextBlock Text="[ESC] Cancela Venda" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <Border Background="#27AE60" CornerRadius="4" Padding="15,5" Margin="5">
                        <TextBlock Text="[F12] FINALIZAR (COBRAR)" Foreground="White" FontWeight="Black" FontSize="14"/>
                    </Border>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- CAMADA 2: MODAL DE FINALIZAÇÃO (Sobreposição) -->
        <Border Background="#F2000000" IsVisible="{Binding IsModalAberto}" ZIndex="100">
            <!-- (Mantivemos a excelência do Modal inalterada) -->
            <Border Background="White" Width="600" CornerRadius="12" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #AAF1C40F">
                <StackPanel Spacing="20">
                    <TextBlock Text="💰 CAIXA - RECEBIMENTO" FontSize="26" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Método:" FontSize="20" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FormasPagamento}" SelectedItem="{Binding FormaPagamentoSelecionada}" HorizontalAlignment="Stretch" Margin="0,0,0,15" FontSize="18"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Subtotal:" FontSize="18" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalVenda, StringFormat='{}R$ {0:N2}'}" FontSize="18" FontWeight="SemiBold" Foreground="#333" HorizontalAlignment="Right" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Acréscimo/Taxa:" FontSize="18" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Acrescimo, StringFormat='{}+ R$ {0:N2}'}" FontSize="18" FontWeight="SemiBold" Foreground="#E67E22" HorizontalAlignment="Right" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Valor a Pagar:" FontSize="24" FontWeight="Black" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalComTaxa, StringFormat='{}R$ {0:N2}'}" FontSize="32" FontWeight="Black" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="2" Background="#ECF0F1" Margin="0,10"/>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Dinheiro Recebido do Cliente (R$):" FontSize="18" FontWeight="Bold" Foreground="#34495E"/>
                        <NumericUpDown Value="{Binding ValorRecebido}" FontSize="36" FontWeight="Black" Foreground="#2C3E50" Increment="5" Minimum="0" FormatString="N2" />
                    </StackPanel>

                    <Border Background="#F9FBFB" BorderBrush="#ECF0F1" BorderThickness="2" CornerRadius="8" Padding="20">
                        <Grid ColumnDefinitions="*, *">
                            <TextBlock Grid.Column="0" Text="TROCO:" FontSize="24" FontWeight="Black" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Troco, StringFormat='{}R$ {0:N2}'}" FontSize="40" FontWeight="Black" Foreground="#2ECC71" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*, *" Margin="0,20,0,0">
                        <Button Grid.Column="0" Command="{Binding FecharModalPagamentoCommand}" Content="[ESC] Desistir" Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="20" Padding="15" Margin="0,0,10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding ConfirmarPagamentoCommand}" Content="✅ CONFIRMAR" Background="#27AE60" Foreground="White" FontSize="22" FontWeight="Black" Padding="15" Margin="10,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding PodeConfirmarPagamento}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>