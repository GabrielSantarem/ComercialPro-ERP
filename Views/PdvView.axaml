<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             xmlns:models="using:GetStartedApp.Models"
             x:Class="GetStartedApp.Views.PdvView"
             x:DataType="vm:PdvViewModel"
             x:Name="RootWindow"
             Focusable="True">

    <Grid Background="#1E272E">
        <!-- CAMADA 1: CONTEÚDO PRINCIPAL (BOCA DE CAIXA) - DESABILITADO QUANDO QUALQUER MODAL ESTIVER ABERTO -->
        <Grid RowDefinitions="Auto, Auto, *, Auto" IsEnabled="{Binding !IsBloqueadoPorModal}">
            
            <!-- TOPO (LINHA 0): Informações do Caixa e Controle de Turnos -->
            <Border Grid.Row="0" Background="#2C3E50" Padding="15,10" BorderBrush="#000" BorderThickness="0,0,0,3">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <!-- Status do Caixa -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{Binding StatusCaixaCor}" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding StatusCaixaTexto}" Foreground="White" FontWeight="Black" FontSize="13"/>
                        </Border>
                        <TextBlock Text="{Binding SaldoCaixaDinheiroTexto}" Foreground="#2ECC71" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Terminal e Operador -->
                    <TextBlock Grid.Column="1" Text="Terminal: 01 (BOCA DE CAIXA)" Foreground="White" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding VendedorSelecionado.Nome, StringFormat='{}Operador: {0}'}" Foreground="#95A5A6" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <!-- Ações de Turno com Teclas de Atalho Claras -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding AbrirModalAberturaCaixaCommand}" IsVisible="{Binding !IsCaixaAberto}" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="12" Padding="10,6" CornerRadius="4" Cursor="Hand">
                            <TextBlock Text="[F1] Abrir Caixa" FontWeight="Black"/>
                        </Button>
                        <Button Command="{Binding AbrirModalSuprimentoCommand}" IsVisible="{Binding IsCaixaAberto}" Background="#2980B9" Foreground="White" FontWeight="Bold" FontSize="12" Padding="8,6" CornerRadius="4" Cursor="Hand">
                            <TextBlock Text="[F6] Suprimento" FontWeight="Bold"/>
                        </Button>
                        <Button Command="{Binding AbrirModalSangriaCommand}" IsVisible="{Binding IsCaixaAberto}" Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="12" Padding="8,6" CornerRadius="4" Cursor="Hand">
                            <TextBlock Text="[F8] Sangria" FontWeight="Bold"/>
                        </Button>
                        <Button Command="{Binding AbrirModalFechamentoCaixaCommand}" IsVisible="{Binding IsCaixaAberto}" Background="#C0392B" Foreground="White" FontWeight="Bold" FontSize="12" Padding="8,6" CornerRadius="4" Cursor="Hand">
                            <TextBlock Text="[F9] Fechar Turno" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FILA DE ESPERA (LINHA 1): PRÉ-VENDAS DO BALCÃO DE ALTO DESTAQUE -->
            <Border Grid.Row="1" Background="#182C3F" Padding="15,8" BorderBrush="#000" BorderThickness="0,0,0,2">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Botão Principal da Fila [F4] -->
                    <Button Grid.Column="0" Command="{Binding AbrirModalFilaBalcaoCommand}" Background="#E67E22" Foreground="White" FontWeight="Black" FontSize="13" Padding="12,6" CornerRadius="4" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#D35400" CornerRadius="3" Padding="6,2">
                                <TextBlock Text="[F4]" Foreground="White" FontWeight="Black" FontSize="11"/>
                            </Border>
                            <TextBlock Text="{Binding FilaPedidos.Count, StringFormat='{}FILA DO BALCÃO ({0} EM ESPERA)'}" Foreground="White" FontWeight="Black" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Lista Rápida Horizontal dos Últimos Pedidos -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="15,0">
                        <ItemsControl ItemsSource="{Binding FilaPedidos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PedidoBalcao">
                                    <Button Command="{Binding #RootWindow.((vm:PdvViewModel)DataContext).PuxarPedidoFilaCommand}" 
                                            CommandParameter="{Binding}"
                                            Background="#2C3E50" BorderBrush="#F39C12" BorderThickness="1" CornerRadius="4" Padding="8,4" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding NumeroComanda}" Foreground="#F1C40F" FontWeight="Black" FontSize="12"/>
                                            <TextBlock Text="|" Foreground="#7F8C8D"/>
                                            <TextBlock Text="{Binding ClienteNome}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="|" Foreground="#7F8C8D"/>
                                            <TextBlock Text="{Binding ValorTotal, StringFormat='{}R$ {0:N2}'}" Foreground="#2ECC71" FontWeight="Black" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Botão Atualizar Fila -->
                    <Button Grid.Column="2" Command="{Binding AtualizarFilaPedidosCommand}" Content="🔄 Atualizar" Background="#34495E" Foreground="#ECF0F1" FontWeight="Bold" FontSize="11" Padding="8,5" CornerRadius="4" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- MEIO (LINHA 2): Divisão Frente de Caixa -->
            <Grid Grid.Row="2" ColumnDefinitions="6*, 4*">
                
                <!-- Lado Esquerdo: Cupom (Lista de Itens) -->
                <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="4" BorderBrush="#BDC3C7" BorderThickness="2" ClipToBounds="True">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <Border Grid.Row="0" Background="#F4F6F7" Padding="10,12" BorderBrush="#BDC3C7" BorderThickness="0,0,0,2">
                            <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*">
                                <TextBlock Grid.Column="0" Text="DESCRIÇÃO" FontWeight="Black" Foreground="#2C3E50" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="QTD" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="V. UNIT (R$)" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="TOTAL (R$)" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        
                        <ListBox x:Name="ListaCarrinho" Grid.Row="1" ItemsSource="{Binding Carrinho}" SelectedItem="{Binding ItemSelecionado}" Background="White" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProdutoItem">
                                    <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" Padding="5,8">
                                        <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*">
                                            <TextBlock Grid.Column="0" Text="{Binding Produto.Nome}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="16" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Produto.Preco, StringFormat='{}{0:N2}'}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat='{}{0:N2}'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#EAEDED" Padding="15,10" BorderBrush="#BDC3C7" BorderThickness="0,2,0,0">
                            <Grid ColumnDefinitions="*, *">
                                <TextBlock Grid.Column="0" Text="SUBTOTAL:" FontSize="20" FontWeight="Black" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalVenda, StringFormat='{}R$ {0:N2}'}" FontSize="28" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lado Direito: Busca Rápida + Painel de Ações -->
                <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="0,15,15,15">
                    
                    <!-- Busca e Lançamento Direto (Venda Direta no Caixa) -->
                    <Border Grid.Row="0" Background="#2C3E50" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="VENDA DIRETA / CÓDIGO (Ex: 5*sacola):" Foreground="#F1C40F" FontSize="13" FontWeight="Bold"/>
                                <Border Grid.Column="1" Background="#34495E" CornerRadius="3" Padding="5,2">
                                    <TextBlock Text="[F2] Foco" Foreground="#ECF0F1" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            
                            <TextBox x:Name="TxtPesquisa" Text="{Binding TextoPesquisa, Mode=TwoWay}" FontSize="20" FontWeight="Bold" Padding="10" Background="White" BorderThickness="0" CornerRadius="4" PlaceholderText="Digite ou bipe o item..."/>

                            <!-- Sugestões da Busca Flutuante -->
                            <ListBox x:Name="ListaSugestoes" ItemsSource="{Binding ResultadosPesquisa}" SelectedItem="{Binding ProdutoPesquisaSelecionado}" MaxHeight="180" Background="White" CornerRadius="4" BorderThickness="0" IsVisible="{Binding ResultadosPesquisa.Count}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Produto">
                                        <Border Padding="8,6" BorderBrush="#ECF0F1" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Preco, StringFormat='{}R$ {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#27AE60"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Command="{Binding LancarProdutoCommand}" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" CornerRadius="4" Cursor="Hand">
                                <TextBlock Text="[ENTER] LANÇAR NO CUPOM" FontWeight="Black"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Painel de Total da Nota em Destaque -->
                    <Border Grid.Row="1" Background="#2C3E50" CornerRadius="4" Padding="20" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="TOTAL A COBRAR" Foreground="#BDC3C7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalVenda, StringFormat='{}R$ {0:N2}'}" Foreground="#2ECC71" FontSize="52" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Carrinho.Count, StringFormat='{}Itens na nota: {0}'}" Foreground="#95A5A6" FontSize="16" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Botões de Ação Rápida -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Command="{Binding CancelarItemSelecionadoCommand}" Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="12" Padding="8" Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="[DEL] Excluir" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding AbrirModalCancelamentoCommand}" Background="#C0392B" Foreground="White" FontWeight="Bold" FontSize="12" Padding="8" Margin="3,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="❌ [F7] Cancelar" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding AbrirModalTrocasCommand}" Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="12" Padding="8" Margin="3,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="🔄 [F10] Trocas" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="3" Command="{Binding AbrirModalPagamentoCommand}" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="12" Padding="8" Margin="3,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="💰 [F12] RECEBER" FontWeight="Black"/>
                        </Button>
                    </Grid>

                </Grid>

            </Grid>

            <!-- RODAPÉ (LINHA 3): Barra de Atalhos -->
            <Border Grid.Row="3" Background="#111" Padding="10">
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="[F4] Fila do Balcão  |  " Foreground="#F39C12" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[ENTER] Lançar/Confirmar  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F2] Foco Busca  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[DEL] Excluir Item  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F7] Cancelar NFC-e  |  " Foreground="#E74C3C" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F10] Trocas/Vales  |  " Foreground="#F39C12" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F8] Sangria  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F12] Receber Nota  |  " Foreground="#2ECC71" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F6] Suprimento  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F9] Fechar Turno  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[ESC] Limpar/Fechar" Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- CAMADA 2: MODAL DE RECEBIMENTO DE PAGAMENTO & SPLIT PAYMENT [F12] -->
        <Border Background="#F2000000" 
                IsVisible="{Binding IsModalAberto}" 
                IsHitTestVisible="{Binding IsModalAberto}"
                ZIndex="100"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="White" Width="680" MaxHeight="720" CornerRadius="12" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #AAF1C40F">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="💰 RECEBIMENTO DE NOTA / CHECKOUT" FontSize="22" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        
                        <!-- Identificação do Cliente / Comanda -->
                        <Border Background="#F4F6F7" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="👤 Cliente / Comanda Balcão:" FontSize="13" FontWeight="Bold" Foreground="#34495E"/>
                                <TextBox x:Name="TxtCliente" Text="{Binding ClienteIdentificacao}" FontSize="15" Padding="8" Background="White" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="4" PlaceholderText="Ex: Seu Pedro (PED-0001)"/>
                            </StackPanel>
                        </Border>

                        <!-- Painel de Totais da Venda -->
                        <Border Background="#F8F9F9" BorderBrush="#E5E8E8" BorderThickness="1" CornerRadius="8" Padding="15">
                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SUBTOTAL" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding TotalVenda, StringFormat='{}R$ {0:N2}'}" FontSize="16" FontWeight="SemiBold" Foreground="#34495E"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TAXA / ACRÉSCIMO" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding Acrescimo, StringFormat='{}+ R$ {0:N2}'}" FontSize="16" FontWeight="SemiBold" Foreground="#E67E22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="TOTAL A PAGAR" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding TotalComTaxa, StringFormat='{}R$ {0:N2}'}" FontSize="24" FontWeight="Black" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Seletor de Forma de Pagamento e Valor da Parcela -->
                        <Border Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ColumnDefinitions="2*, 2*, Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Forma de Pagamento:" FontSize="12" FontWeight="Bold" Foreground="#2980B9"/>
                                    <ComboBox ItemsSource="{Binding FormasPagamento}" SelectedItem="{Binding FormaPagamentoSelecionada}" HorizontalAlignment="Stretch" Height="36" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Valor a Lançar / Recebido:" FontSize="12" FontWeight="Bold" Foreground="#2980B9"/>
                                    <NumericUpDown x:Name="NumValorRecebido" Value="{Binding ValorRecebido}" FontSize="18" FontWeight="Black" Foreground="#2C3E50" Increment="5" Minimum="0" Height="36" FormatString="N2"/>
                                </StackPanel>

                                <Button Grid.Column="2" Command="{Binding AdicionarParcelaPagamentoCommand}" Content="➕ Dividir [F3]" Background="#2980B9" Foreground="White" FontWeight="Bold" Height="36" Padding="12,0" VerticalAlignment="Bottom" CornerRadius="6" Cursor="Hand" ToolTip.Tip="Adiciona como parcela de pagamento mista (Split Payment)"/>
                            </Grid>
                        </Border>

                        <!-- PAINEL AUXILIAR: VALE-CRÉDITO (REV-003) -->
                        <Border Background="#FEF9E7" BorderBrush="#F39C12" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="🎟️ Resgatar Cupom de Vale-Crédito:" FontWeight="Bold" FontSize="12" Foreground="#D35400"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Text="{Binding CodigoValeDigitado}" PlaceholderText="Digite ou bipe o Vale (ex: VALE-2026-XXXXX)..." FontSize="13" Height="34" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Command="{Binding ConsultarEAplicarValeCommand}" Content="Aplicar Vale" Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="12" Height="34" Padding="10,0" CornerRadius="4" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="{Binding MensagemStatusVale}" FontSize="12" FontWeight="Bold" Foreground="#D35400" IsVisible="{Binding MensagemStatusVale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- PAINEL AUXILIAR: CREDIÁRIO / FIADO (REV-003) -->
                        <Border Background="#F4ECF7" BorderBrush="#8E44AD" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="💳 Venda no Crediário / Fiado com Limite:" FontWeight="Bold" FontSize="12" Foreground="#8E44AD"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ClientesCrediario}" SelectedItem="{Binding ClienteCrediarioSelecionado}" HorizontalAlignment="Stretch" Height="34" Margin="0,0,8,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Nome}" FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Command="{Binding AvaliarEAplicarCrediarioCommand}" Content="Aprovar Fiado" Background="#8E44AD" Foreground="White" FontWeight="Bold" FontSize="12" Height="34" Padding="10,0" CornerRadius="4" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="{Binding MensagemStatusCrediario}" FontSize="12" FontWeight="Bold" Foreground="#C0392B" IsVisible="{Binding MensagemStatusCrediario, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- LISTA DE PARCELAS ADICIONADAS (SPLIT PAYMENT) -->
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10" IsVisible="{Binding PagamentosAdicionados.Count}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="💳 Pagamentos Parciais Registrados:" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PagamentosAdicionados.Count, StringFormat='{}{0} parcela(s)'}" FontSize="11" Foreground="#7F8C8D" FontWeight="Bold"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding PagamentosAdicionados}" Background="Transparent" BorderThickness="0" MaxHeight="130">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ItemPagamentoCheckout">
                                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="8,4">
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalAlignment="Center">
                                                    <Border Grid.Column="0" Background="#EAECEE" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Forma}" FontWeight="Bold" FontSize="12" Foreground="#34495E"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Valor, StringFormat='{}R$ {0:N2}'}" FontWeight="Black" FontSize="14" Foreground="#27AE60" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Command="{Binding #RootWindow.((vm:PdvViewModel)DataContext).RemoverParcelaPagamentoCommand}" CommandParameter="{Binding}" Content="✕" Background="#FDEDEC" Foreground="#E74C3C" FontWeight="Bold" FontSize="11" Padding="6,2" CornerRadius="4" Cursor="Hand"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- BARRA DE STATUS DO PAGAMENTO (PAGO / RESTANTE / TROCO) -->
                        <Border Background="#F9FBFB" BorderBrush="#ECF0F1" BorderThickness="2" CornerRadius="8" Padding="12">
                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOTAL PAGO" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding TotalPago, StringFormat='{}R$ {0:N2}'}" FontSize="18" FontWeight="Black" Foreground="#2980B9"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PENDENTE" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding SaldoRestante, StringFormat='{}R$ {0:N2}'}" FontSize="18" FontWeight="Black" Foreground="#E74C3C"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="TROCO" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Troco, StringFormat='{}R$ {0:N2}'}" FontSize="22" FontWeight="Black" Foreground="#2ECC71" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Opção de Emissão Fiscal NFC-e -->
                        <CheckBox IsChecked="{Binding EmitirNfceAoFinalizar}" Margin="0,2,0,0">
                            <TextBlock Text="🏛️ Emitir Cupom Fiscal NFC-e (Zeus Automação)" FontWeight="Bold" Foreground="#2980B9" FontSize="13"/>
                        </CheckBox>

                        <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                            <Button Grid.Column="0" Command="{Binding FecharModalPagamentoCommand}" Content="[ESC] Cancelar" Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="15" Padding="12" Margin="0,0,10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                            <Button Grid.Column="1" Command="{Binding ConfirmarPagamentoCommand}" Content="✅ [ENTER] Confirmar Venda" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="16" Padding="12" Margin="10,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding PodeConfirmarPagamento}" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- CAMADA 3: MODAL DE FILA DE PEDIDOS DO BALCÃO [F4] -->
        <Border Background="#F2000000" 
                IsVisible="{Binding ModalFilaBalcaoAberto}" 
                IsHitTestVisible="{Binding ModalFilaBalcaoAberto}"
                ZIndex="105"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="White" Width="820" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #AAE67E22">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    
                    <!-- Cabeçalho -->
                    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,15">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="📋 FILA DE PEDIDOS DO BALCÃO" FontSize="22" FontWeight="Black" Foreground="#2C3E50"/>
                            <Border Grid.Column="1" Background="#E67E22" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{Binding FilaFiltrada.Count, StringFormat='{}AGUARDANDO: {0}'}" Foreground="White" FontWeight="Black" FontSize="12"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Selecione o pedido do cliente com as setas [↑ / ↓] e tecle [ENTER] para cobrar:" FontSize="13" Foreground="#7F8C8D"/>
                    </StackPanel>

                    <!-- Campo de Busca/Filtro Rápido na Fila -->
                    <TextBox x:Name="TxtFiltroFila" Grid.Row="1" Text="{Binding FiltroFilaBalcao, Mode=TwoWay}" FontSize="16" Padding="10" Background="#F4F6F7" BorderBrush="#BDC3C7" CornerRadius="6" PlaceholderText="🔍 Filtrar por comanda (#PED-0001), cliente ou vendedor..." Margin="0,0,0,12"/>

                    <!-- Tabela / Lista com os Pedidos na Fila -->
                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Height="260">
                        <Grid RowDefinitions="Auto, *">
                            <Border Grid.Row="0" Background="#EAEDED" Padding="10,8" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.2*, 1*, 2.5*, 1.8*, 1*, 1.5*">
                                    <TextBlock Grid.Column="0" Text="COMANDA" FontWeight="Black" FontSize="12" Foreground="#34495E"/>
                                    <TextBlock Grid.Column="1" Text="HORA" FontWeight="Black" FontSize="12" Foreground="#34495E"/>
                                    <TextBlock Grid.Column="2" Text="CLIENTE" FontWeight="Black" FontSize="12" Foreground="#34495E"/>
                                    <TextBlock Grid.Column="3" Text="VENDEDOR" FontWeight="Black" FontSize="12" Foreground="#34495E"/>
                                    <TextBlock Grid.Column="4" Text="ITENS" FontWeight="Black" FontSize="12" Foreground="#34495E" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="VALOR TOTAL" FontWeight="Black" FontSize="12" Foreground="#34495E" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ListBox x:Name="ListaFilaBalcao" Grid.Row="1" ItemsSource="{Binding FilaFiltrada}" SelectedItem="{Binding PedidoFilaSelecionado}" Background="White">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PedidoBalcao">
                                        <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" Padding="8,10">
                                            <Grid ColumnDefinitions="1.2*, 1*, 2.5*, 1.8*, 1*, 1.5*">
                                                <TextBlock Grid.Column="0" Text="{Binding NumeroComanda}" FontWeight="Black" Foreground="#2980B9" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DataHora, StringFormat='{}{0:HH:mm}'}" Foreground="#7F8C8D" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ClienteNome}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Vendedor.Nome}" Foreground="#7F8C8D" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Itens.Count}" FontWeight="Bold" Foreground="#8E44AD" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding ValorTotal, StringFormat='{}R$ {0:N2}'}" FontWeight="Black" Foreground="#27AE60" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Ações de Rodapé do Modal de Fila -->
                    <Grid Grid.Row="3" ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Command="{Binding FecharModalFilaBalcaoCommand}" Content="[ESC] Fechar Fila" Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="14" Padding="12" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                        <Button Grid.Column="1" Command="{Binding ConfirmarSelecaoFilaCommand}" Content="✅ [ENTER] Puxar Pedido para Cobrança" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="15" Padding="12" Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- CAMADA 4: MODAL DE CONTROLE DE TURNO (ABERTURA, SANGRIA, SUPRIMENTO, FECHAMENTO) -->
        <Border Background="#F2000000" 
                IsVisible="{Binding ModalCaixaAberto}" 
                IsHitTestVisible="{Binding ModalCaixaAberto}"
                ZIndex="110"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="White" Width="520" CornerRadius="12" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #AA2C3E50">
                <StackPanel Spacing="15">
                    <TextBlock Text="{Binding TituloModalCaixa}" FontSize="20" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DescricaoModalCaixa}" FontSize="14" Foreground="#7F8C8D" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <!-- Mensagem de Erro de Validação -->
                    <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="{Binding MensagemCaixaErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding MensagemCaixaErro}" Foreground="#C0392B" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Valor em Dinheiro (R$):" FontWeight="Bold" FontSize="14" Foreground="#34495E"/>
                        <NumericUpDown x:Name="NumValorCaixa" Value="{Binding ValorModalCaixa}" Minimum="0" Increment="10" FontSize="26" FontWeight="Black" Foreground="#2C3E50" FormatString="N2" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Motivo / Observação:" FontWeight="Bold" FontSize="14" Foreground="#34495E"/>
                        <TextBox Text="{Binding MotivoModalCaixa}" FontSize="14" Padding="8" Background="#F8F9F9" BorderBrush="#BDC3C7" CornerRadius="4"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Command="{Binding FecharModalCaixaCommand}" Content="[ESC] Cancelar" Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="15" Padding="12" Margin="0,0,10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                        <Button Grid.Column="1" Command="{Binding ConfirmarAcaoCaixaCommand}" Content="[ENTER] Confirmar" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="15" Padding="12" Margin="10,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- CAMADA 5: MODAL DE VISUALIZAÇÃO DA NFC-e EMITIDA (TÉRMICA E DANFE A4) -->
        <Border Background="#F2000000" 
                IsVisible="{Binding ModalNfceEmitidaAberto}" 
                IsHitTestVisible="{Binding ModalNfceEmitidaAberto}"
                ZIndex="120">
            <Border Background="White" Width="720" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #44000000">
                <Grid RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="{Binding UltimaNfceMensagemStatus}" FontSize="18" FontWeight="Black" Foreground="#27AE60"/>
                        <TextBlock Text="{Binding UltimaNfceChaveAcesso, StringFormat='Chave: {0}'}" FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Padding="15" MaxHeight="380">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding UltimaNfceDanfeTexto}" FontFamily="Courier New, Monospace" FontSize="11" Foreground="#00FF66"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Ações de Impressão (Cupom Térmico 80mm & Folha A4 em PDF) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, 1.4*, 1.4*" Margin="0,15,0,0">
                        <Button Grid.Column="0" Command="{Binding FecharModalNfceEmitidaCommand}" Content="[ESC] Fechar" Background="#7F8C8D" Foreground="White" FontWeight="Bold" FontSize="13" Padding="10" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                        <Button Grid.Column="1" Command="{Binding VisualizarDanfeA4PdfCommand}" Content="📄 [F5] Imprimir DANFE A4 (PDF)" Background="#8E44AD" Foreground="White" FontWeight="Bold" FontSize="13" Padding="10" Margin="4,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                        <Button Grid.Column="2" Command="{Binding FecharModalNfceEmitidaCommand}" Content="🖨️ [ENTER] Imprimir Térmico" Background="#2980B9" Foreground="White" FontWeight="Bold" FontSize="13" Padding="10" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- CAMADA 6: MODAL DE CANCELAMENTO FISCAL [F7] (REV-002) -->
        <Border Background="#F2000000" 
                IsVisible="{Binding ModalCancelamentoAberto}" 
                IsHitTestVisible="{Binding ModalCancelamentoAberto}" 
                ZIndex="130"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="White" Width="560" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #AA2C3E50">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="❌ Cancelamento de NFC-e (Evento 110111)" FontSize="18" FontWeight="Black" Foreground="#C0392B"/>
                        <Border Grid.Column="1" Background="#FDEDEC" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="[F7]" Foreground="#C0392B" FontWeight="Black" FontSize="12"/>
                        </Border>
                    </Grid>

                    <!-- Detalhes da Venda Selecionada -->
                    <Border Background="#F8F9F9" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding VendaCancelamento.Id, StringFormat='Venda ID: #{0}'}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VendaCancelamento.ValorTotal, StringFormat='Total: R$ {0:N2}'}" FontWeight="Black" FontSize="14" Foreground="#27AE60" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding VendaCancelamento.DataHora, StringFormat='Data: {0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VendaCancelamento.Status, StringFormat='Status: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#E67E22" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Mensagem de Retorno / Status SEFAZ -->
                    <Border Background="#EAFAF1" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="{Binding MensagemCancelamentoStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding MensagemCancelamentoStatus}" Foreground="#1E8449" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Campo Justificativa Obrigatória (Mínimo 15 caracteres) -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Justificativa do Cancelamento (Mínimo 15 caracteres - SEFAZ):" FontWeight="Bold" FontSize="13" Foreground="#34495E"/>
                            <TextBlock Grid.Column="1" Text="{Binding JustificativaCancelamento.Length, StringFormat='{}{0}/15'}" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                        </Grid>
                        <TextBox x:Name="TxtJustificativaCancelamento" Text="{Binding JustificativaCancelamento}" PlaceholderText="Informe o motivo detalhado do cancelamento..." FontSize="13" Height="65" AcceptsReturn="False" TextWrapping="Wrap" Padding="8" Background="#FAFAFA" BorderBrush="#BDC3C7" CornerRadius="4"/>
                    </StackPanel>

                    <!-- Senha do Supervisor / Gerente -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Senha do Supervisor / Gerente:" FontWeight="Bold" FontSize="13" Foreground="#34495E"/>
                        <TextBox x:Name="TxtSenhaSupervisorCancelamento" Text="{Binding SenhaSupervisorCancelamento}" PasswordChar="*" PlaceholderText="Digite a senha master/supervisor..." FontSize="14" Padding="8" Background="#FAFAFA" BorderBrush="#BDC3C7" CornerRadius="4"/>
                    </StackPanel>

                    <!-- Botões de Ação Zero Mouse -->
                    <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Command="{Binding FecharModalCancelamentoCommand}" Content="[ESC] Cancelar" Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="14" Padding="10" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                        <Button Grid.Column="1" Command="{Binding ConfirmarCancelamentoNfceCommand}" IsEnabled="{Binding !IsCancelandoProcessando}" Content="[ENTER] Confirmar na SEFAZ" Background="#C0392B" Foreground="White" FontWeight="Black" FontSize="14" Padding="10" Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>


        <!-- CAMADA 7: MODAL DE TROCAS, DEVOLUÇÕES & EMISSÃO DE VALE-CRÉDITO [F10] (REV-003) -->
        <Border Background="#F2000000" 
                IsVisible="{Binding ModalTrocasAberto}" 
                IsHitTestVisible="{Binding ModalTrocasAberto}" 
                ZIndex="140"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="White" Width="680" MaxHeight="720" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #AAF39C12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="🔄 Trocas, Devoluções &amp; Emissão de Vale-Crédito" FontSize="18" FontWeight="Black" Foreground="#D35400"/>
                            <Border Grid.Column="1" Background="#FEF9E7" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="[F10]" Foreground="#D35400" FontWeight="Black" FontSize="12"/>
                            </Border>
                        </Grid>

                        <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="8" IsVisible="{Binding TrocaMensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding TrocaMensagemErro}" Foreground="#C0392B" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Caso Vale Gerado: Exibição do Cupom -->
                        <Border Background="#EAFAF1" BorderBrush="#27AE60" BorderThickness="2" CornerRadius="8" Padding="15" IsVisible="{Binding ExibirValeEmitidoModal}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="✅ VALE-CRÉDITO EMITIDO COM SUCESSO!" FontSize="16" FontWeight="Black" Foreground="#27AE60" HorizontalAlignment="Center"/>
                                
                                <Border Background="White" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ValeGeradoSucesso.Codigo, StringFormat='CÓDIGO: {0}'}" FontSize="16" FontWeight="Black" Foreground="#2C3E50"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ValeGeradoSucesso.ValorOriginal, StringFormat='VALOR: R$ {0:N2}'}" FontSize="16" FontWeight="Black" Foreground="#27AE60" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ValeGeradoSucesso.DataValidade, StringFormat='Válido até: {0:dd/MM/yyyy}'}" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ValeGeradoSucesso.ClienteNome, StringFormat='Cliente: {0}'}" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Use este código para abater compras futuras no caixa." FontSize="11" Foreground="#16A085" Margin="0,6,0,0"/>
                                    </Grid>
                                </Border>

                                <Button Command="{Binding FecharModalTrocasCommand}" Content="[ESC] Concluir e Fechar" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" Padding="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Formulário de Devolução -->
                        <StackPanel Spacing="12" IsVisible="{Binding !ExibirValeEmitidoModal}">
                            <Border Background="#F8F9F9" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="10">
                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,5">
                                        <TextBlock Text="Nº Venda Origem (Opcional):" FontSize="12" FontWeight="Bold" Foreground="#34495E"/>
                                        <TextBox Text="{Binding TrocaVendaOrigemTexto}" PlaceholderText="Ex: 105" FontSize="13" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,5">
                                        <TextBlock Text="Motivo da Devolução:" FontSize="12" FontWeight="Bold" Foreground="#34495E"/>
                                        <TextBox Text="{Binding TrocaMotivoGeral}" FontSize="13" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,5,0">
                                        <TextBlock Text="Nome do Cliente:" FontSize="12" FontWeight="Bold" Foreground="#34495E"/>
                                        <TextBox Text="{Binding TrocaClienteNome}" PlaceholderText="Nome do titular..." FontSize="13" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,5,0,0">
                                        <TextBlock Text="CPF do Cliente:" FontSize="12" FontWeight="Bold" Foreground="#34495E"/>
                                        <TextBox Text="{Binding TrocaClienteCpf}" PlaceholderText="000.000.000-00" FontSize="13" Height="32"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Itens Sendo Devolvidos:" FontSize="13" FontWeight="Bold" Foreground="#2C3E50"/>
                            <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" MaxHeight="200">
                                <DataGrid ItemsSource="{Binding ItensParaDevolucao}" AutoGenerateColumns="False" IsReadOnly="False" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PRODUTO" Binding="{Binding ProdutoNome}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="QTD" Binding="{Binding Quantidade}" Width="60"/>
                                        <DataGridTextColumn Header="UNIT." Binding="{Binding PrecoUnitario, StringFormat='R$ {0:N2}'}" Width="90"/>
                                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat='R$ {0:N2}'}" Width="95" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="AVARIA?" Binding="{Binding DestinarAvaria}" Width="75"/>
                                        <DataGridTextColumn Header="MOTIVO" Binding="{Binding Motivo}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Background="#FEF9E7" BorderBrush="#F39C12" BorderThickness="1" CornerRadius="6" Padding="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="VALOR TOTAL DO VALE-CRÉDITO A EMITIR:" FontWeight="Bold" FontSize="13" Foreground="#D35400" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalDevolucao, StringFormat='{}R$ {0:N2}'}" FontWeight="Black" FontSize="20" Foreground="#D35400"/>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                                <Button Grid.Column="0" Command="{Binding FecharModalTrocasCommand}" Content="[ESC] Cancelar" Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="14" Padding="10" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                                <Button Grid.Column="1" Command="{Binding ConfirmarEmissaoValeCommand}" IsEnabled="{Binding !TrocaProcessando}" Content="🎟️ [ENTER] Emitir Vale-Crédito" Background="#E67E22" Foreground="White" FontWeight="Black" FontSize="14" Padding="10" Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

    </Grid>
</UserControl>
