<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             xmlns:models="using:GetStartedApp.Models"
             x:Class="GetStartedApp.Views.EstoqueView"
             x:DataType="vm:EstoqueViewModel">

    <Border Background="#F4F6F7" Padding="20">
        <Grid RowDefinitions="Auto, *">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0" Text="📦 Gestão de Estoque e Suprimentos" FontSize="30" FontWeight="Black" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding MensagemAviso}" FontSize="16" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center"/>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent">
                
                <!-- ABA 1: GERENCIAMENTO E CADASTRO -->
                <TabItem Header="📋 Produtos e Preços" FontSize="16" FontWeight="SemiBold">
                    <Grid ColumnDefinitions="3*, 1.5*" Margin="0,20,0,0">
                        
                        <!-- Lado Esquerdo: Lista de Produtos -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,20,0" BoxShadow="0 4 15 0 #1A000000">
                            <Grid RowDefinitions="Auto, *">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="Inventário Atual" FontSize="22" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
                                        <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding TotalProdutosCriticos}">
                                            <TextBlock Text="{Binding TotalProdutosCriticos, StringFormat='{}🚨 {0} crítico(s)'}" Foreground="#C0392B" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Filtro de Estoque Crítico -->
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SomenteEstoqueCritico}" Content="Ver Apenas Abaixo do Mínimo" FontWeight="Bold" Foreground="#C0392B"/>
                                </Grid>
                                
                                <Border Grid.Row="1" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto, *">
                                        <!-- Header Tabela -->
                                        <Border Grid.Row="0" Background="#F8F9F9" Padding="15,12">
                                            <Grid ColumnDefinitions="3*, 1*, 1.3*">
                                                <TextBlock Grid.Column="0" Text="Produto e Variação" FontWeight="Bold" Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="Preço Unitário" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="Qtd Atual / Mínimo" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <!-- Corpo Tabela -->
                                        <ListBox Grid.Row="1" ItemsSource="{Binding ProdutosLista}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Produto">
                                                    <Border Padding="10" Margin="0,5">
                                                        <Grid ColumnDefinitions="3*, 1*, 1.3*">
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="Medium" Foreground="#2C3E50" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding CodigoBarras, StringFormat='{}EAN: {0}'}" FontSize="11" Foreground="#95A5A6" IsVisible="{Binding CodigoBarras.Length}"/>
                                                            </StackPanel>
                                                            
                                                            <TextBlock Grid.Column="1" Text="{Binding Preco, StringFormat='{}R$ {0:N2}'}" FontSize="15" Foreground="#27AE60" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            
                                                            <!-- Badge de Estoque (com alerta de mínimo) -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Border Background="#FDEDEC" CornerRadius="6" Padding="8,4" IsVisible="{Binding EstaAbaixoDoMinimo}">
                                                                    <TextBlock Text="{Binding Estoque, StringFormat='{}🚨 {0} un (Mín: '}" FontSize="13" Foreground="#C0392B" FontWeight="Black"/>
                                                                </Border>
                                                                <Border Background="#FDEDEC" CornerRadius="6" Padding="0,4,8,4" IsVisible="{Binding EstaAbaixoDoMinimo}">
                                                                    <TextBlock Text="{Binding EstoqueMinimo, StringFormat='{}{0})'}" FontSize="13" Foreground="#C0392B" FontWeight="Black"/>
                                                                </Border>

                                                                <Border Background="#E8F8F5" CornerRadius="6" Padding="8,4" IsVisible="{Binding !EstaAbaixoDoMinimo}">
                                                                    <TextBlock Text="{Binding Estoque, StringFormat='{}✅ {0} un'}" FontSize="13" Foreground="#27AE60" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Lado Direito: Formulário Adicionar -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" BoxShadow="0 4 15 0 #1A000000" VerticalAlignment="Top">
                            <StackPanel Spacing="15">
                                <TextBlock Text="➕ Cadastro Rápido" FontSize="22" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Nome ou Descrição:" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NovoNome}" FontSize="16" Padding="12" Background="#F4F6F7" BorderThickness="0" CornerRadius="6" PlaceholderText="Ex: Fita Adesiva..."/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Preço de Venda (R$):" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <NumericUpDown Value="{Binding NovoPreco}" Minimum="0" Increment="0.5" FontSize="16" Padding="10" Background="#F4F6F7" BorderThickness="0" CornerRadius="6" FormatString="N2"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,6,0">
                                        <TextBlock Text="Estoque Inicial:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                        <NumericUpDown Value="{Binding NovoEstoque}" Minimum="0" Increment="1" FontSize="15" Padding="10" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5" Margin="6,0,0,0">
                                        <TextBlock Text="Estoque Mínimo:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                        <NumericUpDown Value="{Binding NovoEstoqueMinimo}" Minimum="0" Increment="1" FontSize="15" Padding="10" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding SalvarNovoProdutoCommand}" Content="💾 Salvar no Catálogo" Background="#2ECC71" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15" CornerRadius="8" Cursor="Hand" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ABA 2: ENTRADA MANUAL DE NOTAS / MERCADORIAS -->
                <TabItem Header="📥 Entrada de Notas / Compras" FontSize="16" FontWeight="SemiBold">
                    <Grid ColumnDefinitions="4*, 2.5*" Margin="0,20,0,0">
                        
                        <!-- Lado Esquerdo: Dados da Nota + Itens Lançados -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,20,0" BoxShadow="0 4 15 0 #1A000000">
                            <Grid RowDefinitions="Auto, Auto, *, Auto">
                                
                                <!-- Cabeçalho da Nota -->
                                <Border Grid.Row="0" Background="#F8F9F9" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                    <Grid ColumnDefinitions="2*, 3*, 3*" RowDefinitions="Auto, Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nº da Nota / Doc:" FontWeight="Bold" Foreground="#34495E" FontSize="13"/>
                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EntradaNumeroNota}" FontSize="15" Padding="8" Background="White" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="4" PlaceholderText="Ex: 014892" Margin="0,5,10,0"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Fornecedor / Razão Social:" FontWeight="Bold" Foreground="#34495E" FontSize="13"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EntradaFornecedor}" FontSize="15" Padding="8" Background="White" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="4" PlaceholderText="Ex: Distribuidora Silva" Margin="0,5,10,0"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Observações / Frete:" FontWeight="Bold" Foreground="#34495E" FontSize="13"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding EntradaObservacao}" FontSize="15" Padding="8" Background="White" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="4" PlaceholderText="Ex: Entrega Caminhão 02" Margin="0,5,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Título Itens -->
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="Itens da Nota (Conferência Física)" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ItensEntrada.Count, StringFormat='{}Itens: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                                </Grid>

                                <!-- Grade de Itens da Nota -->
                                <Border Grid.Row="2" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto, *">
                                        <Border Grid.Row="0" Background="#34495E" Padding="12,10">
                                            <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*, Auto">
                                                <TextBlock Grid.Column="0" Text="PRODUTO" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="QTD ENTRADA" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="CUSTO UN." Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="TOTAL ITEM" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="AÇÃO" Foreground="White" FontWeight="Bold" FontSize="13" Margin="20,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <ListBox Grid.Row="1" ItemsSource="{Binding ItensEntrada}" Background="Transparent" BorderThickness="0" MinHeight="180">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ItemEntradaTemp">
                                                    <Border Padding="10,8" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*, Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Produto.Nome}" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade, StringFormat='{}+{0}'}" FontSize="15" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CustoUnitario, StringFormat='{}R$ {0:N2}'}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding CustoTotal, StringFormat='{}R$ {0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="4" Command="{Binding $parent[UserControl].((vm:EstoqueViewModel)DataContext).RemoverItemDaNotaCommand}" CommandParameter="{Binding}" Content="❌" Background="Transparent" Foreground="#E74C3C" Margin="15,0,0,0" Padding="5" Cursor="Hand"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Rodapé da Nota: Totalizador e Botão Salvar -->
                                <Border Grid.Row="3" Background="#EAEDED" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBlock Grid.Column="0" Text="Total da Nota a Pagar:" FontSize="18" FontWeight="Black" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalNotaEntrada, StringFormat='{}R$ {0:N2}'}" FontSize="24" FontWeight="Black" Foreground="#E67E22" VerticalAlignment="Center" Margin="0,0,25,0"/>
                                        <Button Grid.Column="2" Command="{Binding ConfirmarEntradaNotaCommand}" Content="✅ Confirmar Entrada no Estoque" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="16" Padding="20,12" CornerRadius="8" Cursor="Hand"/>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- Lado Direito: Adicionar Item na Nota + Histórico Rápido -->
                        <Grid Grid.Column="1" RowDefinitions="Auto, *">
                            
                            <!-- Formulário de Inserção de Item -->
                            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" BoxShadow="0 4 15 0 #1A000000" Margin="0,0,0,15">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="📦 Inserir Item na Nota" FontSize="18" FontWeight="Black" Foreground="#34495E"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Selecionar Produto Cadastrado:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding ProdutosLista}" SelectedItem="{Binding EntradaProdutoSelecionado}" HorizontalAlignment="Stretch" FontSize="14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Produto">
                                                    <TextBlock Text="{Binding Nome}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Qtd Recebida:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                            <NumericUpDown Value="{Binding EntradaQtdItem}" Minimum="1" Increment="1" FontSize="15" Padding="8" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                            <TextBlock Text="Custo Unit. (R$):" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                            <NumericUpDown Value="{Binding EntradaCustoItem}" Minimum="0" Increment="0.5" FontSize="15" Padding="8" Background="#F4F6F7" BorderThickness="0" CornerRadius="6" FormatString="N2"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Command="{Binding AdicionarItemNaNotaCommand}" Content="➕ Adicionar Item à Grade" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" CornerRadius="6" Cursor="Hand" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Histórico de Notas Já Lançadas -->
                            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" BoxShadow="0 4 15 0 #1A000000">
                                <Grid RowDefinitions="Auto, *">
                                    <TextBlock Grid.Row="0" Text="📜 Últimas Entradas" FontSize="16" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding HistoricoEntradas}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:EntradaMercadoria">
                                                <Border Padding="8" Margin="0,4" Background="#F8F9F9" CornerRadius="6" BorderBrush="#ECF0F1" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NumeroNota, StringFormat='{}NF: {0}'}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ValorTotal, StringFormat='{}R$ {0:N2}'}" FontWeight="Black" Foreground="#27AE60" FontSize="14"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Fornecedor}" Foreground="#7F8C8D" FontSize="12"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataEntrada, StringFormat='{}{0:dd/MM HH:mm}'}" Foreground="#95A5A6" FontSize="12"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ABA 3: PERDAS, AVARIAS E AJUSTES (NOVO!) -->
                <TabItem Header="⚠️ Avarias &amp; Ajustes de Saldo" FontSize="16" FontWeight="SemiBold">
                    <Grid ColumnDefinitions="3*, 4*" Margin="0,20,0,0">
                        
                        <!-- Lado Esquerdo: Formulário de Ajuste -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,20,0" BoxShadow="0 4 15 0 #1A000000" VerticalAlignment="Top">
                            <StackPanel Spacing="15">
                                <TextBlock Text="📝 Registrar Baixa por Avaria ou Ajuste" FontSize="20" FontWeight="Black" Foreground="#2C3E50"/>
                                <TextBlock Text="Utilize para descartes de mercadoria rasgada, vencida ou correção de contagem." FontSize="13" Foreground="#7F8C8D"/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Selecionar Produto:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding ProdutosLista}" SelectedItem="{Binding AjusteProdutoSelecionado}" HorizontalAlignment="Stretch" FontSize="14">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Produto">
                                                <TextBlock Text="{Binding Nome}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Mostrador do estoque atual -->
                                <Border Background="#F8F9F9" Padding="12" CornerRadius="6" BorderBrush="#BDC3C7" BorderThickness="1" IsVisible="{Binding AjusteProdutoSelecionado, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Estoque Físico Atual no Sistema:" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AjusteProdutoSelecionado.Estoque, StringFormat='{}{0} un'}" FontWeight="Black" FontSize="16" Foreground="#2980B9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                        <TextBlock Text="Tipo de Ajuste:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding TiposAjuste}" SelectedItem="{Binding AjusteTipoSelecionado}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                        <TextBlock Text="Quantidade:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                        <NumericUpDown Value="{Binding AjusteQuantidade}" Minimum="1" Increment="1" FontSize="15" Padding="8" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Motivo / Justificativa Obrigatória:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding AjusteMotivo}" PlaceholderText="Ex: Fardo molhou na chuva / Embalagem furada" FontSize="14" Padding="10" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Operador / Responsável:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding AjusteResponsavel}" FontSize="14" Padding="10" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                </StackPanel>

                                <Button Command="{Binding RegistrarAjusteEstoqueCommand}" Content="🚨 Confirmar Baixa / Ajuste" 
                                        Background="#E74C3C" Foreground="White" FontWeight="Black" FontSize="15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14" CornerRadius="8" Cursor="Hand" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Lado Direito: Histórico de Ajustes -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" BoxShadow="0 4 15 0 #1A000000">
                            <Grid RowDefinitions="Auto, *">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                                    <TextBlock Grid.Column="0" Text="📜 Auditoria de Ajustes &amp; Perdas" FontSize="18" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding CarregarHistoricoAjustesCommand}" Content="🔄 Atualizar" Background="#34495E" Foreground="White" FontWeight="Bold" FontSize="12" Padding="10,5" CornerRadius="4" Cursor="Hand"/>
                                </Grid>

                                <ListBox Grid.Row="1" ItemsSource="{Binding HistoricoAjustes}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AjusteEstoque">
                                            <Border Padding="12" Margin="0,4" Background="#F8F9F9" CornerRadius="8" BorderBrush="#ECF0F1" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto">
                                                    
                                                    <!-- Badge do Tipo -->
                                                    <Border Grid.Row="0" Grid.Column="0" Background="#FDEDEC" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TipoAjuste}" FontWeight="Black" FontSize="11" Foreground="#C0392B"/>
                                                    </Border>

                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Produto.Nome}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14" VerticalAlignment="Center"/>

                                                    <!-- Diferença -->
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding QuantidadeDiferenca, StringFormat='{}{0} un'}" FontWeight="Black" Foreground="#E74C3C" FontSize="15" VerticalAlignment="Center"/>

                                                    <!-- Subdetalhes: Motivo e Operador -->
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="15" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Motivo, StringFormat='Motivo: {0}'}" FontSize="12" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding EstoqueAnterior, StringFormat='({0}'}" FontSize="11" Foreground="#95A5A6"/>
                                                        <TextBlock Text="{Binding EstoqueNovo, StringFormat='-> {0} un)'}" FontSize="11" Foreground="#95A5A6"/>
                                                        <TextBlock Text="{Binding Responsavel, StringFormat='Resp: {0}'}" FontSize="11" Foreground="#95A5A6"/>
                                                        <TextBlock Text="{Binding DataHora, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="11" Foreground="#BDC3C7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Nenhum ajuste registrado até o momento." 
                                           Foreground="#95A5A6" FontStyle="Italic" HorizontalAlignment="Center" Margin="20"
                                           IsVisible="{Binding !HistoricoAjustes.Count}"/>
                            </Grid>
                        </Border>

                    </Grid>
                </TabItem>

                <!-- ABA 4: RELATÓRIO / CONTAGEM FISICA CAIXA -->
                <TabItem Header="🔄 Fechamento Físico (Giro do Dia)" FontSize="16" FontWeight="SemiBold">
                     <Border Background="White" CornerRadius="12" Padding="25" Margin="0,20,0,0" BoxShadow="0 4 15 0 #1A000000">
                        <Grid RowDefinitions="Auto, *">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,25">
                                <TextBlock Text="Filtrar Movimentação:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#34495E" />
                                <CalendarDatePicker SelectedDate="{Binding DataFiltro}" Width="220" FontSize="16" Padding="10" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="6"/>
                                <Button Command="{Binding BuscarGiroEstoqueCommand}" Content="🔍 Gerar Relatório" Background="#3498DB" Foreground="White" FontWeight="Bold" Padding="20,10" CornerRadius="6" FontSize="16" VerticalAlignment="Center" Cursor="Hand"/>
                            </StackPanel>

                            <Border Grid.Row="1" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Cabeçalho do relatorio -->
                                    <Border Grid.Row="0" Background="#34495E" Padding="15">
                                        <Grid ColumnDefinitions="3*, 1.5*, 1.5*, 1.5*">
                                            <TextBlock Grid.Column="0" Text="Nome do Produto" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Qtd Vendida" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="Qtd Atual Sist." Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="Contagem Papel" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding Relatorio}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="15,10" Margin="0,5">
                                                    <Grid ColumnDefinitions="3*, 1.5*, 1.5*, 1.5*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="16" FontWeight="Medium" Foreground="#2C3E50" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding QuantidadeVendida, StringFormat='{}-{0} un'}" FontSize="16" Foreground="#E74C3C" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding EstoqueAtualSistema, StringFormat='{}{0} un'}" FontSize="16" Foreground="#27AE60" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="3" BorderBrush="#BDC3C7" BorderThickness="0,0,0,2" Margin="30,0" Height="25" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                     </Border>
                </TabItem>

                <!-- ABA 5: AUDITORIA & INVENTÁRIO FÍSICO (CONFERÊNCIA CEGA) -->
                <TabItem Header="🔍 Auditoria &amp; Inventário Físico" FontSize="16" FontWeight="SemiBold">
                    <Grid RowDefinitions="Auto, *">
                        <!-- BANNER / KPIS DE CONFERÊNCIA -->
                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid ColumnDefinitions="*, *, *, *, Auto">
                                <!-- Card 1: Total Auditados -->
                                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="ITENS AUDITADOS" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding ResumoAuditoria.TotalItensAuditados, StringFormat='{}{0} itens'}" FontSize="18" FontWeight="Black" Foreground="#2C3E50" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ResumoAuditoria.TotalItensBatidos, StringFormat='{}OK: {0} 100% batidos'}" FontSize="11" Foreground="#27AE60" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Quebras / Perdas -->
                                <Border Grid.Column="1" Background="#FDEDEC" BorderBrush="#F5B7B1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="QUEBRAS / FURTOS" FontSize="11" FontWeight="Bold" Foreground="#C0392B"/>
                                        <TextBlock Text="{Binding ResumoAuditoria.TotalItensQuebra, StringFormat='{}{0} produtos com falta'}" FontSize="14" FontWeight="Bold" Foreground="#C0392B" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ResumoAuditoria.PrejuizoQuebrasCusto, StringFormat='{}-R$ {0:N2} prejuízo'}" FontSize="16" FontWeight="Black" Foreground="#C0392B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Sobras -->
                                <Border Grid.Column="2" Background="#E8F8F5" BorderBrush="#A3E4D7" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="SOBRAS DE ESTOQUE" FontSize="11" FontWeight="Bold" Foreground="#16A085"/>
                                        <TextBlock Text="{Binding ResumoAuditoria.TotalItensSobra, StringFormat='{}{0} produtos a mais'}" FontSize="14" FontWeight="Bold" Foreground="#16A085" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ResumoAuditoria.ValorSobrasCusto, StringFormat='{}+R$ {0:N2} sobra'}" FontSize="16" FontWeight="Black" Foreground="#16A085" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Saldo Líquido -->
                                <Border Grid.Column="3" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,15,0">
                                    <StackPanel>
                                        <TextBlock Text="IMPACTO LÍQUIDO (CUSTO)" FontSize="11" FontWeight="Bold" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding ResumoAuditoria.SaldoLiquidoCusto, StringFormat='{}R$ {0:N2}'}" FontSize="18" FontWeight="Black" Foreground="#2980B9" Margin="0,4,0,0"/>
                                        <TextBlock Text="Balanço Real de Caixa" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botões de Ação Rápida -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="8">
                                    <Button Content="📄 Folha de Contagem Cega" Command="{Binding GerarFolhaContagemCommand}" Background="#34495E" Foreground="White" FontWeight="Bold" Padding="12,8" CornerRadius="6"/>
                                    <Button Content="🔄 Recarregar Catálogo" Command="{Binding CarregarAuditoriaCommand}" Background="#7F8C8D" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ÁREA PRINCIPAL DE CONTAGEM -->
                        <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto">
                            <!-- BARRA DE LANÇAMENTO RÁPIDO -->
                            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="3*, 1.5*, Auto, 2*, 2*, Auto" VerticalAlignment="Center">
                                    <!-- Busca / Bipe -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Bipar Código de Barras / Digitar Nome:" FontSize="11" FontWeight="Bold" Foreground="#555"/>
                                        <TextBox Text="{Binding EntradaCodigoOuNomeContagem, Mode=TwoWay}" PlaceholderText="Bipe o código ou digite o nome..." Height="36" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Quantidade Contada -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Qtd Física Contada:" FontSize="11" FontWeight="Bold" Foreground="#555"/>
                                        <NumericUpDown Value="{Binding EntradaQtdFisicaContada, Mode=TwoWay}" Minimum="0" Maximum="999999" Height="36" FormatString="0"/>
                                    </StackPanel>

                                    <!-- Botão Lançar -->
                                    <Button Grid.Column="2" Content="➕ Registrar" Command="{Binding LancarContagemRapidaCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" Height="36" Padding="15,0" VerticalAlignment="Bottom" Margin="0,0,15,0" CornerRadius="6"/>

                                    <!-- Responsável -->
                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                        <TextBlock Text="Responsável / Auditor:" FontSize="11" FontWeight="Bold" Foreground="#555"/>
                                        <TextBox Text="{Binding ResponsavelInventario, Mode=TwoWay}" Height="36" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Observação -->
                                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                        <TextBlock Text="Observação / Motivo:" FontSize="11" FontWeight="Bold" Foreground="#555"/>
                                        <TextBox Text="{Binding ObservacaoInventario, Mode=TwoWay}" Height="36" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Botão Efetivar -->
                                    <Button Grid.Column="5" Content="⚡ Efetivar Inventário" Command="{Binding EfetivarInventarioCommand}" Background="#8E44AD" Foreground="White" FontWeight="Black" Height="36" Padding="15,0" VerticalAlignment="Bottom" CornerRadius="6"/>
                                </Grid>
                            </Border>

                            <!-- TABELA DE CONFERÊNCIA DE ESTOQUE -->
                            <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Cabeçalho -->
                                    <Border Grid.Row="0" Background="#2C3E50" Padding="12,10">
                                        <Grid ColumnDefinitions="1.5*, 3.5*, 1.2*, 1.5*, 1.5*, 1.5*, 1.5*">
                                            <TextBlock Grid.Column="0" Text="Código / EAN" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="Produto" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="Saldo Sist." Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="Físico Contado" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="Divergência" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="Impacto Custo" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="Situação" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Lista de Itens -->
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ItensAuditoria}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="1.5*, 3.5*, 1.2*, 1.5*, 1.5*, 1.5*, 1.5*" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="{Binding CodigoBarras}" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProdutoNome}" FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SaldoSistema, StringFormat='{}{0} un'}" FontSize="13" FontWeight="Bold" Foreground="#34495E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SaldoFisicoContado, TargetNullValue='-- pendente --'}" FontWeight="Black" FontSize="13" Foreground="#2980B9"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="4" Text="{Binding Diferenca, StringFormat='{}{0:+0;-0;0} un'}" FontSize="13" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C0392B"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding ImpactoCusto, StringFormat='{}R$ {0:N2}'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#2C3E50"/>
                                                        <Border Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="10,3" Background="#EAECEE">
                                                            <TextBlock Text="{Binding StatusDivergencia}" FontSize="11" FontWeight="Bold" Foreground="#2C3E50"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- MODAL / PAINEL DA FOLHA DE CONTAGEM CEGA -->
                            <Border Grid.Row="0" Grid.RowSpan="3" Background="#AA000000" IsVisible="{Binding ExibirFolhaContagem}" Padding="50">
                                <Border Background="White" CornerRadius="10" Padding="25" MaxWidth="900" MaxHeight="650">
                                    <Grid RowDefinitions="Auto, *, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                                            <TextBlock Grid.Column="0" Text="📋 Folha de Contagem Cega de Estoque" FontSize="18" FontWeight="Black" Foreground="#2C3E50"/>
                                            <Button Grid.Column="1" Content="✕ Fechar" Command="{Binding FecharFolhaContagemCommand}" Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="10,5" CornerRadius="6"/>
                                        </Grid>

                                        <TextBox Grid.Row="1" Text="{Binding FolhaContagemTexto}" FontFamily="Monospace" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                                            <TextBlock Text="💡 Copie ou envie este texto diretamente para impressora térmica ou folha A4." FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                            <Button Content="Concluir Visualização" Command="{Binding FecharFolhaContagemCommand}" Background="#2980B9" Foreground="White" FontWeight="Bold" Padding="15,8" CornerRadius="6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>

</UserControl>
