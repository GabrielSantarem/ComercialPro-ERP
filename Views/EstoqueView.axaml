<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             xmlns:models="using:GetStartedApp.Models"
             x:Class="GetStartedApp.Views.EstoqueView"
             x:DataType="vm:EstoqueViewModel">

    <Border Background="#F4F6F7" Padding="20">
        <Grid RowDefinitions="Auto, *">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0" Text="📦 Gestão de Estoque e Suprimentos" FontSize="30" FontWeight="Black" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding MensagemAviso}" FontSize="16" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center"/>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent">
                
                <!-- ABA 1: GERENCIAMENTO E CADASTRO -->
                <TabItem Header="📋 Produtos e Preços" FontSize="16" FontWeight="SemiBold">
                    <Grid ColumnDefinitions="3*, 1.5*" Margin="0,20,0,0">
                        
                        <!-- Lado Esquerdo: Lista de Produtos -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,20,0" BoxShadow="0 4 15 0 #1A000000">
                            <Grid RowDefinitions="Auto, *">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                                    <TextBlock Grid.Column="0" Text="Inventário Atual" FontSize="22" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Status de Caixa Forte" FontSize="14" Foreground="#95A5A6" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Border Grid.Row="1" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto, *">
                                        <!-- Header Tabela -->
                                        <Border Grid.Row="0" Background="#F8F9F9" Padding="15,12">
                                            <Grid ColumnDefinitions="3*, 1*, 1*">
                                                <TextBlock Grid.Column="0" Text="Produto e Variação" FontWeight="Bold" Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="Preço Unitário" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="Qtd Atual" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <!-- Corpo Tabela -->
                                        <ListBox Grid.Row="1" ItemsSource="{Binding ProdutosLista}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10" Margin="0,5">
                                                        <Grid ColumnDefinitions="3*, 1*, 1*">
                                                            <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="16" FontWeight="Medium" Foreground="#2C3E50" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Preco, StringFormat='{}R$ {0:N2}'}" FontSize="16" Foreground="#27AE60" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Estoque, StringFormat='{}{0} Cx/Un'}" FontSize="14" Foreground="#D35400" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Lado Direito: Formulário Adicionar -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" BoxShadow="0 4 15 0 #1A000000" VerticalAlignment="Top">
                            <StackPanel Spacing="15">
                                <TextBlock Text="➕ Cadastro Rápido" FontSize="22" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Nome ou Descrição:" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NovoNome}" FontSize="16" Padding="12" Background="#F4F6F7" BorderThickness="0" CornerRadius="6" PlaceholderText="Ex: Fita Adesiva..."/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Preço de Venda (R$):" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <NumericUpDown Value="{Binding NovoPreco}" Minimum="0" Increment="0.5" FontSize="16" Padding="10" Background="#F4F6F7" BorderThickness="0" CornerRadius="6" FormatString="N2"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Qtd de Estoque Inicial:" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <NumericUpDown Value="{Binding NovoEstoque}" Minimum="0" Increment="1" FontSize="16" Padding="10" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                </StackPanel>

                                <Button Command="{Binding SalvarNovoProdutoCommand}" Content="💾 Salvar no Catálogo" Background="#2ECC71" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15" CornerRadius="8" Cursor="Hand" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ABA 2: ENTRADA MANUAL DE NOTAS / MERCADORIAS (NOVO!) -->
                <TabItem Header="📥 Entrada de Notas / Compras" FontSize="16" FontWeight="SemiBold">
                    <Grid ColumnDefinitions="4*, 2.5*" Margin="0,20,0,0">
                        
                        <!-- Lado Esquerdo: Dados da Nota + Itens Lançados -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,20,0" BoxShadow="0 4 15 0 #1A000000">
                            <Grid RowDefinitions="Auto, Auto, *, Auto">
                                
                                <!-- Cabeçalho da Nota -->
                                <Border Grid.Row="0" Background="#F8F9F9" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                    <Grid ColumnDefinitions="2*, 3*, 3*" RowDefinitions="Auto, Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nº da Nota / Doc:" FontWeight="Bold" Foreground="#34495E" FontSize="13"/>
                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EntradaNumeroNota}" FontSize="15" Padding="8" Background="White" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="4" PlaceholderText="Ex: 014892" Margin="0,5,10,0"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Fornecedor / Razão Social:" FontWeight="Bold" Foreground="#34495E" FontSize="13"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EntradaFornecedor}" FontSize="15" Padding="8" Background="White" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="4" PlaceholderText="Ex: Distribuidora Silva" Margin="0,5,10,0"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Observações / Frete:" FontWeight="Bold" Foreground="#34495E" FontSize="13"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding EntradaObservacao}" FontSize="15" Padding="8" Background="White" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="4" PlaceholderText="Ex: Entrega Caminhão 02" Margin="0,5,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Título Itens -->
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="Itens da Nota (Conferência Física)" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ItensEntrada.Count, StringFormat='{}Itens: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                                </Grid>

                                <!-- Grade de Itens da Nota -->
                                <Border Grid.Row="2" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto, *">
                                        <Border Grid.Row="0" Background="#34495E" Padding="12,10">
                                            <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*, Auto">
                                                <TextBlock Grid.Column="0" Text="PRODUTO" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="QTD ENTRADA" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="CUSTO UN." Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="TOTAL ITEM" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="AÇÃO" Foreground="White" FontWeight="Bold" FontSize="13" Margin="20,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <ListBox Grid.Row="1" ItemsSource="{Binding ItensEntrada}" Background="Transparent" BorderThickness="0" MinHeight="180">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ItemEntradaTemp">
                                                    <Border Padding="10,8" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*, Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Produto.Nome}" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade, StringFormat='{}+{0}'}" FontSize="15" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CustoUnitario, StringFormat='{}R$ {0:N2}'}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding CustoTotal, StringFormat='{}R$ {0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="4" Command="{Binding $parent[UserControl].((vm:EstoqueViewModel)DataContext).RemoverItemDaNotaCommand}" CommandParameter="{Binding}" Content="❌" Background="Transparent" Foreground="#E74C3C" Margin="15,0,0,0" Padding="5" Cursor="Hand"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Rodapé da Nota: Totalizador e Botão Salvar -->
                                <Border Grid.Row="3" Background="#EAEDED" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBlock Grid.Column="0" Text="Total da Nota a Pagar:" FontSize="18" FontWeight="Black" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalNotaEntrada, StringFormat='{}R$ {0:N2}'}" FontSize="24" FontWeight="Black" Foreground="#E67E22" VerticalAlignment="Center" Margin="0,0,25,0"/>
                                        <Button Grid.Column="2" Command="{Binding ConfirmarEntradaNotaCommand}" Content="✅ Confirmar Entrada no Estoque" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="16" Padding="20,12" CornerRadius="8" Cursor="Hand"/>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- Lado Direito: Adicionar Item na Nota + Histórico Rápido -->
                        <Grid Grid.Column="1" RowDefinitions="Auto, *">
                            
                            <!-- Formulário de Inserção de Item -->
                            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" BoxShadow="0 4 15 0 #1A000000" Margin="0,0,0,15">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="📦 Inserir Item na Nota" FontSize="18" FontWeight="Black" Foreground="#34495E"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Selecionar Produto Cadastrado:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding ProdutosLista}" SelectedItem="{Binding EntradaProdutoSelecionado}" HorizontalAlignment="Stretch" FontSize="14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Produto">
                                                    <TextBlock Text="{Binding Nome}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Qtd Recebida:" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                            <NumericUpDown Value="{Binding EntradaQtdItem}" Minimum="1" Increment="1" FontSize="15" Padding="8" Background="#F4F6F7" BorderThickness="0" CornerRadius="6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                            <TextBlock Text="Custo Unit. (R$):" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                            <NumericUpDown Value="{Binding EntradaCustoItem}" Minimum="0" Increment="0.5" FontSize="15" Padding="8" Background="#F4F6F7" BorderThickness="0" CornerRadius="6" FormatString="N2"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Command="{Binding AdicionarItemNaNotaCommand}" Content="➕ Adicionar Item à Grade" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" CornerRadius="6" Cursor="Hand" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Histórico de Notas Já Lançadas -->
                            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" BoxShadow="0 4 15 0 #1A000000">
                                <Grid RowDefinitions="Auto, *">
                                    <TextBlock Grid.Row="0" Text="📜 Últimas Entradas" FontSize="16" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding HistoricoEntradas}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:EntradaMercadoria">
                                                <Border Padding="8" Margin="0,4" Background="#F8F9F9" CornerRadius="6" BorderBrush="#ECF0F1" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NumeroNota, StringFormat='{}NF: {0}'}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ValorTotal, StringFormat='{}R$ {0:N2}'}" FontWeight="Black" Foreground="#27AE60" FontSize="14"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Fornecedor}" Foreground="#7F8C8D" FontSize="12"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataEntrada, StringFormat='{}{0:dd/MM HH:mm}'}" Foreground="#95A5A6" FontSize="12"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ABA 3: RELATÓRIO / CONTAGEM FISICA CAIXA -->
                <TabItem Header="🔄 Fechamento Físico (Giro do Dia)" FontSize="16" FontWeight="SemiBold">
                     <Border Background="White" CornerRadius="12" Padding="25" Margin="0,20,0,0" BoxShadow="0 4 15 0 #1A000000">
                        <Grid RowDefinitions="Auto, *">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,25">
                                <TextBlock Text="Filtrar Movimentação:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#34495E" />
                                <CalendarDatePicker SelectedDate="{Binding DataFiltro}" Width="220" FontSize="16" Padding="10" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="6"/>
                                <Button Command="{Binding BuscarGiroEstoqueCommand}" Content="🔍 Gerar Relatório" Background="#3498DB" Foreground="White" FontWeight="Bold" Padding="20,10" CornerRadius="6" FontSize="16" VerticalAlignment="Center" Cursor="Hand"/>
                            </StackPanel>

                            <Border Grid.Row="1" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Cabeçalho do relatorio -->
                                    <Border Grid.Row="0" Background="#34495E" Padding="15">
                                        <Grid ColumnDefinitions="3*, 1.5*, 1.5*, 1.5*">
                                            <TextBlock Grid.Column="0" Text="Nome do Produto" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Qtd Vendida" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="Qtd Atual Sist." Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="Contagem Papel" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding Relatorio}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="15,10" Margin="0,5">
                                                    <Grid ColumnDefinitions="3*, 1.5*, 1.5*, 1.5*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="16" FontWeight="Medium" Foreground="#2C3E50" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding QuantidadeVendida, StringFormat='{}-{0} un'}" FontSize="16" Foreground="#E74C3C" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding EstoqueAtualSistema, StringFormat='{}{0} un'}" FontSize="16" Foreground="#27AE60" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="3" BorderBrush="#BDC3C7" BorderThickness="0,0,0,2" Margin="30,0" Height="25" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                     </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>

</UserControl>
