<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GetStartedApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="GetStartedApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Comercial Pro ERP"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">
        
        <!-- CABEÇALHO GLOBAL (Substitui a velha barra lateral) -->
        <Border Grid.Row="0" Background="#2C3E50" Height="70" Padding="20,0" BoxShadow="0 2 10 0 #55000000" ZIndex="100">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                
                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="🛒" FontSize="28"/>
                    <TextBlock Text="Comercial Pro ERP" Foreground="White" FontSize="22" FontWeight="Black" VerticalAlignment="Center" LetterSpacing="1"/>
                </StackPanel>

                <!-- Status Usuário -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" IsVisible="{Binding !IsHome}">
                    <TextBlock Text="Operador: Padrão" Foreground="#95A5A6" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>

                <!-- Botão Voltar (Hub) - Escondido se já estiver na Home -->
                <Button Grid.Column="3" Content="⬅️ Voltar aos Módulos" 
                        Command="{Binding NavigateToHomeCommand}" 
                        IsVisible="{Binding !IsHome}"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="16" Padding="15,8" CornerRadius="8" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ESPAÇO DE TRABALHO (Carrega Pdv, Estoque ou Dashboard) -->
        <Border Grid.Row="1" Background="#ECF0F1">
            <TransitioningContentControl Content="{Binding CurrentPage}" />
        </Border>
        
    </Grid>

</Window>