<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             xmlns:models="using:GetStartedApp.Models"
             x:Class="GetStartedApp.Views.BalcaoView"
             x:DataType="vm:BalcaoViewModel"
             x:Name="RootBalcaoWindow"
             Focusable="True">

    <Grid Background="#1E272E">
        <!-- CAMADA 1: INTERFACE PRINCIPAL DO BALCÃO -->
        <Grid RowDefinitions="Auto, Auto, *, Auto" IsEnabled="{Binding !IsBloqueadoPorModal}">
            
            <!-- TOPO: Identificação Limpa do Terminal e Vendedor -->
            <Border Grid.Row="0" Background="#2C3E50" Padding="15,10" BorderBrush="#000" BorderThickness="0,0,0,3">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <!-- Badge do Modo Balcão -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="#3498DB" CornerRadius="4" Padding="10,5">
                            <TextBlock Text="🛍️ BALCÃO 01 (PRÉ-VENDA)" Foreground="White" FontWeight="Black" FontSize="13"/>
                        </Border>
                        <TextBlock Text="Terminal Rápido de Lançamento" Foreground="#BDC3C7" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Atendente / Vendedor com Atalho [F1] e Alternador Clicável -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,15,0">
                        <Button Command="{Binding TrocarVendedorProximoCommand}" 
                                Background="#1A252F" BorderBrush="#F39C12" BorderThickness="1.5"
                                CornerRadius="6" Padding="10,6" Cursor="Hand" ToolTip.Tip="Pressione [F1] ou clique para alternar o atendente">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="#F39C12" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="[F1]" Foreground="White" FontWeight="Black" FontSize="11"/>
                                </Border>
                                <TextBlock Text="Vendedor:" Foreground="#BDC3C7" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding VendedorSelecionado.Nome}" Foreground="#F1C40F" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                                <TextBlock Text="🔄" FontSize="12" Foreground="#E67E22" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ComboBox ItemsSource="{Binding Vendedores}" 
                                  SelectedIndex="{Binding VendedorIndex, Mode=TwoWay}"
                                  SelectedItem="{Binding VendedorSelecionado, Mode=TwoWay}" 
                                  Width="180" Background="White" CornerRadius="4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Vendedor">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Botão Limpar Pedido [ESC] -->
                    <Button Grid.Column="3" Command="{Binding LimparCarrinhoCommand}" Background="#7F8C8D" Foreground="White" FontWeight="Bold" FontSize="12" Padding="10,6" CornerRadius="4" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="[ESC] Novo Pedido" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- BANNER DISCRETO DE COMANDA GERADA (NÃO-BLOQUEANTE - ACT-07) -->
            <Border Grid.Row="1" Background="#27AE60" Padding="16,10" IsVisible="{Binding BannerComandaSucesso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="{Binding BannerComandaSucesso}" Foreground="White" FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Command="{Binding AbrirModalConfirmacaoCommand}" Background="#1E8449" Foreground="White" FontWeight="Bold" Padding="12,5" CornerRadius="4" Content="📄 Visualizar Bobina" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- MEIO: Divisão Itens + Painel de Lançamento -->
            <Grid Grid.Row="2" ColumnDefinitions="6*, 4*">
                
                <!-- Lado Esquerdo: Itens da Pré-Venda -->
                <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="4" BorderBrush="#BDC3C7" BorderThickness="2" ClipToBounds="True">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <Border Grid.Row="0" Background="#F4F6F7" Padding="10,12" BorderBrush="#BDC3C7" BorderThickness="0,0,0,2">
                            <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*">
                                <TextBlock Grid.Column="0" Text="PRODUTO / DESCRIÇÃO" FontWeight="Black" Foreground="#2C3E50" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="QTD" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="V. UNIT (R$)" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="TOTAL (R$)" FontWeight="Black" Foreground="#2C3E50" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        
                        <ListBox x:Name="ListaCarrinho" Grid.Row="1" ItemsSource="{Binding Carrinho}" SelectedItem="{Binding ItemSelecionado}" Background="White" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProdutoItem">
                                    <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" Padding="5,8">
                                        <Grid ColumnDefinitions="3*, 1*, 1.5*, 1.5*">
                                            <TextBlock Grid.Column="0" Text="{Binding Produto.Nome}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="16" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Produto.Preco, StringFormat='{}{0:N2}'}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat='{}{0:N2}'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Totalizador Compacto da Lista -->
                        <Border Grid.Row="2" Background="#EAEDED" Padding="15,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="RESUMO DO PEDIDO" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Carrinho.Count, StringFormat='Total de Itens: {0}'}" FontWeight="Black" Foreground="#2C3E50" FontSize="14"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lado Direito: Busca Rápida + Caixa de Subtotal + Atalhos -->
                <Grid Grid.Column="1" Margin="0,15,15,15" RowDefinitions="Auto, *, Auto">
                    
                    <!-- Campo de Lançamento Direto -->
                    <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="15" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="2">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="LANÇAMENTO RÁPIDO [F2]" FontWeight="Black" Foreground="#2C3E50" FontSize="14"/>
                                <Border Grid.Column="1" Background="#F1C40F" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="Ex: 5*arroz" Foreground="#7D6608" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <TextBox x:Name="TxtPesquisa" 
                                         Text="{Binding TextoPesquisa, Mode=TwoWay}" 
                                         Watermark="Nome ou Código de Barras... [ENTER]" 
                                         FontSize="16" Height="45" VerticalContentAlignment="Center" 
                                         CornerRadius="4" BorderThickness="2" BorderBrush="#3498DB"/>

                                <!-- Popup de Sugestões de Busca Integrado -->
                                <Popup IsOpen="{Binding ResultadosPesquisa.Count}" 
                                       Placement="Bottom" PlacementTarget="{Binding #TxtPesquisa}" 
                                       MaxHeight="250" IsLightDismissEnabled="False">
                                    <Border Background="White" BorderBrush="#3498DB" BorderThickness="1.5" CornerRadius="4" BoxShadow="0 4 12 0 #30000000" Width="360">
                                        <ListBox ItemsSource="{Binding ResultadosPesquisa}" SelectedItem="{Binding ProdutoPesquisaSelecionado, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Produto">
                                                    <Grid ColumnDefinitions="*, Auto" Margin="5">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="{Binding CodigoBarras}" FontSize="11" Foreground="#7F8C8D"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Preco, StringFormat='R$ {0:N2}'}" FontWeight="Black" Foreground="#27AE60" FontSize="13" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Button Command="{Binding LancarProdutoCommand}" Background="#2980B9" Foreground="White" FontWeight="Black" FontSize="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" CornerRadius="4" Cursor="Hand">
                                <TextBlock Text="[ENTER] LANÇAR NO PEDIDO" FontWeight="Black"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Painel de Destaque -->
                    <Border Grid.Row="1" Background="#2C3E50" CornerRadius="4" Padding="20" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="SUBTOTAL DA PRÉ-VENDA" Foreground="#BDC3C7" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalVenda, StringFormat='{}R$ {0:N2}'}" Foreground="#2ECC71" FontSize="50" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Carrinho.Count, StringFormat='{}Itens adicionados: {0}'}" Foreground="#95A5A6" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Ações de Teclado -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Command="{Binding CancelarItemSelecionadoCommand}" Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14" Padding="12" Margin="0,0,5,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="[F8] Excluir Item" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding SolicitarEnvioAoCaixaCommand}" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="15" Padding="12" Margin="5,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="🚀 [F12] ENVIAR AO CAIXA" FontWeight="Black"/>
                        </Button>
                    </Grid>

                </Grid>

            </Grid>

            <!-- RODAPÉ: Guia Completo de Teclas -->
            <Border Grid.Row="3" Background="#111" Padding="10">
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="[ENTER] Lançar Item  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[5*item] Multiplicador  |  " Foreground="#F1C40F" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[↓ / ↑] Navegar Sugestões  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F1] Trocar Vendedor  |  " Foreground="#E67E22" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F2] Foco Busca  |  " Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F8] Excluir Item  |  " Foreground="#E74C3C" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[F12] Salvar e Enviar ao Caixa  |  " Foreground="#2ECC71" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="[ESC] Limpar Pedido" Foreground="#BDC3C7" FontSize="13" FontWeight="Bold"/>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- CAMADA 2: MODAL DE IDENTIFICAÇÃO RÁPIDA DO CLIENTE (ACIONADO NO [F12]) -->
        <Border Background="#F2000000" 
                IsVisible="{Binding ModalIdentificacaoAberto}" 
                IsHitTestVisible="{Binding ModalIdentificacaoAberto}"
                ZIndex="90"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="White" Width="520" CornerRadius="12" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #AA3498DB">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="5">
                        <TextBlock Text="👤 IDENTIFICAÇÃO DO CLIENTE" FontSize="20" FontWeight="Black" Foreground="#2C3E50"/>
                        <TextBlock Text="Opcional. Pressione [ENTER] para emitir diretamente ao balcão." FontSize="13" Foreground="#7F8C8D"/>
                    </StackPanel>

                    <Separator Background="#ECF0F1" Height="1"/>

                    <!-- Campo Nome -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Nome do Cliente (ou Descrição):" FontWeight="Bold" Foreground="#34495E"/>
                        <TextBox x:Name="TxtNomeCliente" Text="{Binding ClienteNome, Mode=TwoWay}" FontSize="15" Height="40" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Campo CPF/CNPJ -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="CPF / CNPJ na Nota (Opcional):" FontWeight="Bold" Foreground="#34495E"/>
                        <TextBox Text="{Binding ClienteCpf, Mode=TwoWay}" Watermark="000.000.000-00" FontSize="15" Height="40" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#EBF5FB" CornerRadius="6" Padding="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="ℹ️" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Ao confirmar, o pedido entrará na fila do Caixa Central e poderá ser faturado imediatamente." Foreground="#2980B9" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Botões -->
                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Command="{Binding CancelarIdentificacaoCommand}" Background="#BDC3C7" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Padding="12" Margin="0,0,5,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" Cursor="Hand">
                            <TextBlock Text="[ESC] Voltar"/>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ConfirmarEnvioAoCaixaCommand}" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="14" Padding="12" Margin="5,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" Cursor="Hand">
                            <TextBlock Text="[ENTER] Gerar Comanda"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- CAMADA 3: MODAL DE COMANDA GERADA (PROTÓTIPO DE CUPOM TÉRMICO 80MM / 58MM) -->
        <Border Background="#F2000000" 
                IsVisible="{Binding IsModalConfirmacaoAberto}" 
                IsHitTestVisible="{Binding IsModalConfirmacaoAberto}"
                ZIndex="100"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="White" Width="860" MaxHeight="680" CornerRadius="14" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 15 40 0 #60000000">
                <Grid ColumnDefinitions="1.1*, 1*">
                    
                    <!-- LADO ESQUERDO: CONTROLES E RESUMO -->
                    <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,25,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✅" FontSize="24"/>
                            <TextBlock Text="PRÉ-VENDA ENVIADA AO CAIXA" FontSize="20" FontWeight="Black" Foreground="#27AE60" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Box do Pedido -->
                        <Border Background="#E8F8F5" BorderBrush="#A3E4D7" BorderThickness="2" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="NÚMERO DA COMANDA BALCÃO" FontSize="12" FontWeight="Bold" Foreground="#16A085" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NumeroComandaGerada}" FontSize="42" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ValorComandaGerada, StringFormat='{}Total a Pagar: R$ {0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#27AE60" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding MensagemConfirmacao}" FontSize="13" Foreground="#34495E" TextWrapping="Wrap" LineHeight="18"/>

                        <!-- Seleção de Largura da Bobina -->
                        <Border Background="#F8F9F9" Padding="12" CornerRadius="6" BorderBrush="#BDC3C7" BorderThickness="1">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Formato da Impressora:" FontWeight="Bold" FontSize="12" Foreground="#34495E"/>
                                    <TextBlock Text="Simulação de corte e largura" FontSize="11" Foreground="#7F8C8D"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LargurasDisponiveis}" SelectedItem="{Binding LarguraCupomSelecionada}" Width="110" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- Feedback de Impressão -->
                        <Border Background="#D4EFDF" BorderBrush="#27AE60" BorderThickness="1" CornerRadius="4" Padding="8" IsVisible="{Binding StatusImpressaoFeedback.Length}">
                            <TextBlock Text="{Binding StatusImpressaoFeedback}" Foreground="#196F3D" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Botões de Ação -->
                        <StackPanel Spacing="8">
                            <Button Command="{Binding SimularImpressaoEscPosCommand}" 
                                    Content="🖨️ Simular Impressão Térmica (ESC/POS)" 
                                    Background="#2980B9" Foreground="White" FontWeight="Bold" FontSize="14" Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" Cursor="Hand"/>
                            
                            <Button Command="{Binding FecharModalConfirmacaoCommand}" 
                                    Content="⏎ [ENTER] Voltar ao Balcão" 
                                    Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="15" Padding="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- LADO DIREITO: VISUALIZADOR REALISTA DE BOBINA TÉRMICA -->
                    <Border Grid.Column="1" Background="#FFFDF7" BorderBrush="#D5D8DC" BorderThickness="1" CornerRadius="6" Padding="16,14" BoxShadow="0 6 18 0 #25000000" VerticalAlignment="Stretch">
                        <Grid RowDefinitions="Auto, *, Auto">
                            
                            <!-- Serrilha Topo -->
                            <TextBlock Grid.Row="0" Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" 
                                       Foreground="#BDC3C7" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Conteúdo do Cupom -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                <TextBlock Text="{Binding TextoCupomTermico}" 
                                           FontFamily="Consolas, Cascadia Mono, Courier New, monospace" 
                                           FontSize="11" 
                                           Foreground="#1B2631" 
                                           LineHeight="16"
                                           TextWrapping="NoWrap"
                                           HorizontalAlignment="Center"/>
                            </ScrollViewer>

                            <!-- Serrilha Base -->
                            <TextBlock Grid.Row="2" Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" 
                                       Foreground="#BDC3C7" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>
