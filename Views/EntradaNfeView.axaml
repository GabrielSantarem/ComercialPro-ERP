<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GetStartedApp.ViewModels"
             xmlns:models="using:GetStartedApp.Models"
             x:Class="GetStartedApp.Views.EntradaNfeView"
             x:Name="RootEntradaView"
             x:DataType="vm:EntradaNfeViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="25">
            
            <!-- HEADER DA PÁGINA COM AÇÕES -->
            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#BDC3C7" BorderThickness="1">
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="RECEBIMENTO FISCAL (ENTRADA DE NOTAS)" FontSize="24" FontWeight="Black" Foreground="#2C3E50"/>
                            <Border Background="{Binding StatusCor}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusDocumento}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Documentos Fiscais de Entrada (NF-e Mod. 55 e NFC-e Mod. 65) • Integração de Estoque e Contas a Pagar" FontSize="14" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,15,0">
                        <Button Click="BtnImportarXml_Click" Background="#2980B9" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15,10" CornerRadius="6" Cursor="Hand" ToolTip.Tip="Abre caixa de diálogo para escolher arquivo .xml físico">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📁"/>
                                <TextBlock Text="Selecionar Arquivo .XML"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2" Command="{Binding ProcessarEntradaFiscalCommand}" Background="#27AE60" Foreground="White" FontWeight="Black" FontSize="15" Padding="20,10" CornerRadius="6" Cursor="Hand" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🚀"/>
                            <TextBlock Text="LANÇAR ESTOQUE &amp; CUSTOS"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- FEEDBACK / ALERTA -->
            <Border Background="#EBF5FB" BorderBrush="#3498DB" BorderThickness="1" CornerRadius="6" Padding="15,10" IsVisible="{Binding MensagemFeedback.Length}">
                <TextBlock Text="{Binding MensagemFeedback}" FontSize="14" FontWeight="Bold" Foreground="#2980B9"/>
            </Border>

            <!-- SEÇÃO 1: CABEÇALHO DA NF-e & EMITENTE -->
            <Grid ColumnDefinitions="6*, 4*" Margin="0,5">
                
                <!-- Dados do Fornecedor / Nota -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="🏢 Identificação do Fornecedor &amp; Dados Fiscais" FontSize="16" FontWeight="Black" Foreground="#2C3E50" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#EBF5FB" BorderBrush="#3498DB" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding TipoDocumentoDescricao}" FontSize="12" FontWeight="Bold" Foreground="#2980B9"/>
                            </Border>
                        </Grid>
                        
                        <Grid ColumnDefinitions="3*, 1*, 2*">
                            <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                                <TextBlock Text="Razão Social do Emitente:" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <TextBox Text="{Binding FornecedorRazao}" FontWeight="Bold" Background="#F8F9F9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,10,0">
                                <TextBlock Text="UF:" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <TextBox Text="{Binding FornecedorUf}" HorizontalContentAlignment="Center" Background="#F8F9F9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="CNPJ:" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <TextBox Text="{Binding FornecedorCnpj}" Background="#F8F9F9"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="2*, 1*, 3*">
                            <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                                <TextBlock Text="Número da Nota:" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <TextBox Text="{Binding NumeroNota}" FontWeight="Black" FontSize="16" Foreground="#2980B9" Background="#F8F9F9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,10,0">
                                <TextBlock Text="Série:" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <TextBox Text="{Binding SerieNota}" HorizontalContentAlignment="Center" Background="#F8F9F9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="Chave de Acesso (44 dígitos):" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <TextBox Text="{Binding ChaveAcesso}" FontFamily="Monospace" FontSize="12" Background="#F8F9F9"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Despesas Acessórias & Rateio de Frete -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🚚 Logística &amp; Rateio de Despesas" FontSize="16" FontWeight="Black" Foreground="#2C3E50"/>
                        
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,5,0">
                                <TextBlock Text="Frete (R$):" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <NumericUpDown Value="{Binding ValorFrete}" FormatString="C2" Increment="5" Background="#F8F9F9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5" Margin="5,0,0,0">
                                <TextBlock Text="Outras Despesas (R$):" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <NumericUpDown Value="{Binding OutrasDespesas}" FormatString="C2" Increment="5" Background="#F8F9F9"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F4F6F7" CornerRadius="6" Padding="12" Margin="0,5,0,0">
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Total dos Produtos:" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding TotalProdutos, StringFormat='{}R$ {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="TOTAL DA NOTA:" FontSize="12" FontWeight="Black" Foreground="#E67E22"/>
                                    <TextBlock Text="{Binding ValorTotalNota, StringFormat='{}R$ {0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#27AE60"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- SEÇÃO 2: ITENS DA NOTA COM DE/PARA E FATOR DE CONVERSÃO -->
            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel Spacing="15">
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📦 Itens da Nota Fiscal &amp; Formação de Preço (DataGrid)" FontSize="18" FontWeight="Black" Foreground="#2C3E50"/>
                            <TextBlock Text="Grade de alta densidade com colunas redimensionáveis, conversão de estoque, markup e preço de venda" FontSize="13" Foreground="#7F8C8D"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ItensNota.Count, StringFormat='{}Total de Itens: {0}'}" FontSize="15" FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- DATAGRID PROFISSIONAL COM COLUNAS REDIMENSIONÁVEIS -->
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding ItensNota}"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="All"
                                  MinHeight="220"
                                  MaxHeight="450"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding NumeroItem}" IsReadOnly="True" Width="45"/>
                                
                                <DataGridTemplateColumn Header="CÓDIGO / EAN" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ItemNotaFiscalVm">
                                            <StackPanel VerticalAlignment="Center" Margin="5,2">
                                                <TextBlock Text="{Binding CodigoFornecedor}" FontFamily="Monospace" FontWeight="SemiBold" FontSize="11" Foreground="#34495E"/>
                                                <TextBlock Text="{Binding CodigoEan, StringFormat='{}EAN: {0}'}" FontSize="10" Foreground="#7F8C8D" IsVisible="{Binding CodigoEan.Length}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="DESCRIÇÃO NA NOTA" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ItemNotaFiscalVm">
                                            <TextBlock Text="{Binding DescricaoFornecedor}" FontWeight="SemiBold" Foreground="#2C3E50" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="NCM" Binding="{Binding Ncm}" IsReadOnly="True" Width="95"/>
                                <DataGridTextColumn Header="UN." Binding="{Binding UnidadeFornecedor}" IsReadOnly="True" Width="55"/>
                                <DataGridTextColumn Header="QTD NOTA" Binding="{Binding QuantidadeFaturada}" IsReadOnly="True" Width="80"/>

                                <DataGridTemplateColumn Header="FATOR (X)" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ItemNotaFiscalVm">
                                            <NumericUpDown Value="{Binding FatorConversao}" Minimum="1" Increment="1" FontSize="12" Padding="2" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="QTD REAL" Binding="{Binding QuantidadeEstoque, StringFormat='{}{0} un'}" FontWeight="Black" Foreground="#27AE60" IsReadOnly="True" Width="85"/>
                                <DataGridTextColumn Header="CUSTO UN." Binding="{Binding CustoUnitarioEstoque, StringFormat='{}R$ {0:N2}'}" FontWeight="Black" Foreground="#E67E22" IsReadOnly="True" Width="100"/>

                                <DataGridTemplateColumn Header="MARKUP (%)" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ItemNotaFiscalVm">
                                            <NumericUpDown Value="{Binding MarkupPercentual}" Minimum="0" Maximum="1000" Increment="5" FormatString="N1" FontSize="12" Padding="2" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="PREÇO VENDA (R$)" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ItemNotaFiscalVm">
                                            <NumericUpDown Value="{Binding PrecoVendaFinal}" Minimum="0.01" Increment="0.50" FormatString="C2" FontSize="12" Padding="2" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2980B9"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="PRODUTO NO ERP" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ItemNotaFiscalVm">
                                            <StackPanel Margin="5,2" VerticalAlignment="Center">
                                                <ComboBox ItemsSource="{Binding #RootEntradaView.((vm:EntradaNfeViewModel)DataContext).ProdutosDisponiveis}" 
                                                          SelectedItem="{Binding ProdutoVinculado}" 
                                                          HorizontalAlignment="Stretch" 
                                                          FontSize="12">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:Produto">
                                                            <TextBlock Text="{Binding Nome}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="✨ Criará item no catálogo com este Preço de Venda" FontSize="10" Foreground="#27AE60" FontWeight="Bold" Margin="0,2,0,0" IsVisible="{Binding IsProdutoNovo}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="AÇÃO" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ItemNotaFiscalVm">
                                            <Button Command="{Binding #RootEntradaView.((vm:EntradaNfeViewModel)DataContext).RemoverItemCommand}" 
                                                    CommandParameter="{Binding}" 
                                                    Content="❌" 
                                                    Background="Transparent" 
                                                    Foreground="#E74C3C" 
                                                    Padding="5" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center" 
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- SEÇÃO 3: FINANCEIRO & DUPLICATAS DA NOTA -->
            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="💳 Integração com Contas a Pagar (Duplicatas)" FontSize="18" FontWeight="Black" Foreground="#2C3E50"/>
                            <TextBlock Text="Parcelas apuradas a partir do XML ou condição de pagamento" FontSize="13" Foreground="#7F8C8D"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Condição:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#7F8C8D"/>
                            <ComboBox ItemsSource="{Binding CondicoesPagamento}" SelectedItem="{Binding CondicaoPagamentoSelecionada}" Width="230"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Parcelas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParcelaFinanceiroVm">
                                <Border Background="#F4F6F7" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="0,0,12,10" Width="200">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Documento}" FontWeight="Bold" Foreground="#2980B9" FontSize="13"/>
                                        <TextBlock Text="{Binding Vencimento, StringFormat='{}Vencimento: {0:dd/MM/yyyy}'}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding Valor, StringFormat='{}R$ {0:N2}'}" FontSize="18" FontWeight="Black" Foreground="#27AE60"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
